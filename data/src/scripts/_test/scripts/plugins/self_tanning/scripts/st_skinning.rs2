[proc,skinning_checker]()(obj)
def_int $lvl0 = %hunter;
def_obj $obj1 = null;
if (inv_total(inv, e_dragon_knife) > 0) {
    $obj1 = e_dragon_knife;
} else if (inv_total(inv, e_rune_knife) > 0) {
    $obj1 = e_rune_knife;
} else if (inv_total(inv, e_adamant_knife) > 0) {
    $obj1 = e_adamant_knife;
} else if (inv_total(inv, e_mithril_knife) > 0) {
    $obj1 = e_mithril_knife;
} else if (inv_total(inv, e_steel_knife) > 0) {
    $obj1 = e_steel_knife;
} else if (inv_total(inv, e_iron_knife) > 0) {
    $obj1 = e_iron_knife;
} else if (inv_total(inv, e_bronze_knife) > 0) {
    $obj1 = e_bronze_knife;
} else if (inv_total(inv, founders_knife) > 0) {
    $obj1 = founders_knife;
} else if (inv_total(inv, hc_knife) > 0) {
    $obj1 = hc_knife;
} else if (inv_total(inv, knife) > 0) {
    $obj1 = knife;
}
if ($lvl0 >= oc_param(e_dragon_knife, levelrequire) & ($obj1 = e_dragon_knife)) {
    return(e_dragon_knife);
}
if ($lvl0 >= oc_param(e_rune_knife, levelrequire) & ($obj1 = e_rune_knife)) {
    return(e_rune_knife);
}
if ($lvl0 >= oc_param(e_adamant_knife, levelrequire) & ($obj1 = e_adamant_knife)) {
    return(e_adamant_knife);
}
if ($lvl0 >= oc_param(e_mithril_knife, levelrequire) & ($obj1 = e_mithril_knife)) {
    return(e_mithril_knife);
}
if ($lvl0 >= oc_param(steel_knife, levelrequire) & ($obj1 = e_steel_knife)) {
    return(steel_knife);
}
if ($lvl0 >= oc_param(e_iron_knife, levelrequire) & ($obj1 = e_iron_knife)) {
    return(e_iron_knife);
}
if ($lvl0 >= oc_param(e_bronze_knife, levelrequire) & ($obj1 = e_bronze_knife)) {
    return(e_bronze_knife);
}
if ($lvl0 >= oc_param(hc_knife, levelrequire) & ($obj1 = hc_knife)) {
    return(hc_knife);
}
if ($lvl0 >= oc_param(founders_knife, levelrequire) & ($obj1 = founders_knife)) {
    return(founders_knife);
}
return(null);