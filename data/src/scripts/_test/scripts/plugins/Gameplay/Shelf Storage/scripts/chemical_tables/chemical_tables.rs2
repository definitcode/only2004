[oploc1,loc_619] @chemical_tables_open(loc_619);
[oploc1,loc_618] @chemical_tables_open(loc_618);

[inv_button1,ct_side:inv] @chemical_tables_deposit(last_slot, 1);
[inv_button2,ct_side:inv] @chemical_tables_deposit(last_slot, 5);
[inv_button3,ct_side:inv] @chemical_tables_deposit(last_slot, 10);
[inv_button4,ct_side:inv] @chemical_tables_deposit(last_slot, ^max_32bit_int);
[inv_button5,ct_side:inv] @chemical_tables_deposit(last_slot, null);
[inv_buttond,ct_side:inv] inv_movetoslot(inv, inv, last_slot, last_targetslot);

[inv_button1,ct_main:inv] @chemical_tables_withdraw(last_slot, 1);
[inv_button2,ct_main:inv] @chemical_tables_withdraw(last_slot, 5);
[inv_button3,ct_main:inv] @chemical_tables_withdraw(last_slot, 10);
[inv_button4,ct_main:inv] @chemical_tables_withdraw(last_slot, ^max_32bit_int);
[inv_button5,ct_main:inv] @chemical_tables_withdraw(last_slot, null);
[inv_buttond,ct_main:inv] inv_movetoslot(chemical_tables, chemical_tables, last_slot, last_targetslot);

[if_button,ct_main:com_94] %ct_noted = 0;
[if_button,ct_main:com_93] %ct_noted = 1;
[if_close,ct_main] @chemical_tables_close;

[label,chemical_tables_open](loc $loc)
~clearallq;
if (%gamemode_selected = ^gamemode_uim | %gamemode_selected = ^gamemode_hcuim){
    mes("Ultimate Ironman cannot use Chemical Tables!");
    return;
} else if (%gamemode_selected = ^gamemode_pvp | %pk_skull > 0){
    mes("Murderers cannot use Chemical Tables.");
    return;
} else if (%biohazard_progress ! ^biohazard_complete){
    mes("You need to complete the Biohazard quest to use Chemical Tables.");
    return;
} else if (%intelligence < 90){
    mes("You need at least level 90 Intelligence to use Chemical Tables.");
    return;
}
%ct_noted = 0;
~reorganize_inv(chemical_tables);
inv_transmit(inv, ct_side:inv);
inv_transmit(chemical_tables, ct_main:inv);
if_openmain_side(ct_main, ct_side);

[label,chemical_tables_close]
inv_stoptransmit(ct_side:inv);
inv_stoptransmit(ct_main:inv);
queue(reorganize_chemshelves, 0);

[queue,reorganize_chemshelves]
~reorganize_inv(chemical_tables);

[label,chemical_tables_deposit](int $slot, int $requested_number)
def_obj $item = inv_getobj(inv, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(inv, $item);
if ($requested_number < $number) $number = $requested_number;
if (~chemical_tables_check_nobreak($item) = true) {
    return;
}
~ct_deposit_request(inv, $item, $number, $slot);

[label,chemical_tables_withdraw](int $slot, int $requested_number)
def_obj $item = inv_getobj(chemical_tables, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(chemical_tables, $item);
if ($requested_number < $number) $number = $requested_number;
~ct_withdraw_request(inv, $item, $number, $slot);

[proc,ct_withdraw_request](inv $inv, obj $obj, int $amount, int $slot)
def_obj $cert_or_uncert = oc_uncert($obj);
if (%ct_noted ! 0) {
    $cert_or_uncert = oc_cert($obj);
}
if (%ct_noted = ^true & oc_cert($obj) = $obj) {
    mes("This item can not be withdrawn as a note.");
}
if (inv_itemspace($inv, $cert_or_uncert, $amount, inv_size($inv)) = false){
    if (inv_freespace($inv) = 0) {
        mes("You don't have enough inventory space.");
        return;
    } else if (oc_stackable($cert_or_uncert) = true) {
        mes("You're not going to be able to carry all that!");
    } else {
        mes("You don't have enough inventory space to withdraw that many.");
    }
}
def_int $overflow = inv_itemspace2($inv, $cert_or_uncert, $amount, inv_size($inv));
def_int $withdraw = sub($amount, $overflow);
if ($withdraw > 0) {
    session_log(^log_moderator, "Withdrew <oc_debugname($obj)> x<tostring($withdraw)> from Chemical Tables");
    switch_int (%ct_noted) {
        case 0 : inv_moveitem_uncert(chemical_tables, $inv, $obj, $withdraw);
        case default : inv_moveitem_cert(chemical_tables, $inv, $obj, $withdraw);
    }
}

[proc,ct_deposit_request](inv $inv, obj $obj, int $amount, int $slot)
def_int $overflow = inv_itemspace2(chemical_tables, oc_uncert($obj), $amount, ^max_32bit_int);
if (sub(^max_32bit_int, $amount) < inv_total(chemical_tables, $obj)) {
    mes("You already have a full stack of that item in the shelves.");
} else if ($overflow >= $amount) {
    mes("You don't have enough space in your cooking shelves.");
    return;
}
def_int $deposit = sub($amount, $overflow);
if ($deposit > 0) {
    session_log(^log_moderator, "Deposited <oc_debugname($obj)> x<tostring($deposit)> into Chemical Tables");
    inv_moveitem_uncert($inv, chemical_tables, $obj, $deposit);
}

[proc,chemical_tables_check_nobreak](obj $obj)(boolean)
if (~chemical_tables_find_obj_unbankable($obj) = false) {
    mes("I can't store that here!");
    return(true);
}
if (map_members = false) {
    if ((inv_total(chemical_tables, oc_uncert($obj)) = 0) & (sub(inv_size(chemical_tables), inv_freespace(chemical_tables)) >= ^bank_free_slots)) {
        mes("You need to subscribe for a members account if you want to");
        mes("store any more items in the Chemical Tables.");
        return(true);
    }
}
return(false);

