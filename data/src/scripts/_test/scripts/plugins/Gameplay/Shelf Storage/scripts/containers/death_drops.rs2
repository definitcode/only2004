[proc,container_check]()(int)
def_int $bucket_fish = inv_total(inv, bucket_fish);
def_int $engineer_box = inv_total(inv, engineer_box);
def_int $herb_bag = inv_total(inv, herb_bag);
if ($bucket_fish > 0 & $engineer_box > 0 & $herb_bag > 0){
    return(5);
} else if ($bucket_fish > 0 & $engineer_box > 0) {
    return(4);
} else if ($herb_bag > 0) {
    return(3);
} else if ($engineer_box > 0) {
    return(2);
} else if ($bucket_fish > 0) {
    return(1);
}
return(0);


[proc,storage_check]
switch_int(~container_check){
    case 1 : {
        inv_dropall(fish_bucket, coord, ^lootdrop_duration);
        inv_dropitem(inv, coord, bucket_fish, 1, ^lootdrop_duration);
    }
    case 2 : {
        inv_dropall(engineer_box, coord, ^lootdrop_duration);
        inv_dropitem(inv, coord, engineer_box, 1, ^lootdrop_duration);
    }
    case 3 : {
        inv_dropall(herb_bag, coord, ^lootdrop_duration);
        inv_dropitem(inv, coord, herb_bag, 1, ^lootdrop_duration);
    }
    case 4 : {
        inv_dropall(fish_bucket, coord, ^lootdrop_duration);
        inv_dropall(engineer_box, coord, ^lootdrop_duration);
        inv_dropitem(inv, coord, bucket_fish, 1, ^lootdrop_duration);
        inv_dropitem(inv, coord, engineer_box, 1, ^lootdrop_duration);
    }
    case 5 : {
        inv_dropall(fish_bucket, coord, ^lootdrop_duration);
        inv_dropall(engineer_box, coord, ^lootdrop_duration);
        inv_dropall(herb_bag, coord, ^lootdrop_duration);
        inv_dropitem(inv, coord, bucket_fish, 1, ^lootdrop_duration);
        inv_dropitem(inv, coord, engineer_box, 1, ^lootdrop_duration);
        inv_dropitem(inv, coord, herb_bag, 1, ^lootdrop_duration);
    }
}