[opheld1,engineer_box] @engineer_box_open(engineer_box);

[inv_button1,eb_side:inv] @engineer_box_deposit(last_slot, 1);
[inv_button2,eb_side:inv] @engineer_box_deposit(last_slot, 5);
[inv_button3,eb_side:inv] @engineer_box_deposit(last_slot, 10);
[inv_button4,eb_side:inv] @engineer_box_deposit(last_slot, ^max_32bit_int);
[inv_button5,eb_side:inv] @engineer_box_deposit(last_slot, null);
[inv_buttond,eb_side:inv] inv_movetoslot(inv, inv, last_slot, last_targetslot);

[inv_button1,eb_main:inv] @engineer_box_withdraw(last_slot, 1);
[inv_button2,eb_main:inv] @engineer_box_withdraw(last_slot, 5);
[inv_button3,eb_main:inv] @engineer_box_withdraw(last_slot, 10);
[inv_button4,eb_main:inv] @engineer_box_withdraw(last_slot, ^max_32bit_int);
[inv_button5,eb_main:inv] @engineer_box_withdraw(last_slot, null);
[inv_buttond,eb_main:inv] inv_movetoslot(engineer_box, engineer_box, last_slot, last_targetslot);

[if_button,eb_main:com_94] %eb_noted = 0;
[if_button,eb_main:com_93] %eb_noted = 1;
[if_close,eb_main] @engineer_box_close;

[label,engineer_box_open](obj $obj)
~clearallq;
if (%gamemode_selected = ^gamemode_uim | %gamemode_selected = ^gamemode_hcuim){
    mes("Ultimate Ironman cannot use an Engineer Box!");
    return;
} else if (%gamemode_selected = ^gamemode_pvp | %pk_skull > 0){
    mes("Murderers cannot use an Engineer Box!");
    return;
} else if (%doric_progress ! ^doric_complete) {
    mes("You need to complete the Doric quest to use Engineer Box.");
    return;
} else if (%engineering < 90) {
    mes("You need at least level 90 Engineering to use this!");
    return;
}
%eb_noted = 0;
~reorganize_inv(engineer_box);
inv_transmit(inv, eb_side:inv);
inv_transmit(engineer_box, eb_main:inv);
if_openmain_side(eb_main, eb_side);

[label,engineer_box_close]
inv_stoptransmit(eb_side:inv);
inv_stoptransmit(eb_main:inv);
queue(reorganize_engineer_box, 0);

[queue,reorganize_engineer_box]
~reorganize_inv(engineer_box);

[label,engineer_box_deposit](int $slot, int $requested_number)
def_obj $item = inv_getobj(inv, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(inv, $item);
if ($requested_number < $number) $number = $requested_number;
if (~engineer_box_check_nobreak($item) = true) {
    return;
}
~eb_deposit_request(inv, $item, $number, $slot);

[label,engineer_box_withdraw](int $slot, int $requested_number)
def_obj $item = inv_getobj(engineer_box, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(engineer_box, $item);
if ($requested_number < $number) $number = $requested_number;
~eb_withdraw_request(inv, $item, $number, $slot);

[proc,eb_withdraw_request](inv $inv, obj $obj, int $amount, int $slot)
def_obj $cert_or_uncert = oc_uncert($obj);
if (%eb_noted ! 0) {
    $cert_or_uncert = oc_cert($obj);
}
if (%eb_noted = ^true & oc_cert($obj) = $obj) {
    mes("This item can not be withdrawn as a note.");
}
if (inv_itemspace($inv, $cert_or_uncert, $amount, inv_size($inv)) = false){
    if (inv_freespace($inv) = 0) {
        mes("You don't have enough inventory space.");
        return;
    } else if (oc_stackable($cert_or_uncert) = true) {
        mes("You're not going to be able to carry all that!");
    } else {
        mes("You don't have enough inventory space to withdraw that many.");
    }
}
def_int $overflow = inv_itemspace2($inv, $cert_or_uncert, $amount, inv_size($inv));
def_int $withdraw = sub($amount, $overflow);
if ($withdraw > 0) {
    session_log(^log_moderator, "Withdrew <oc_debugname($obj)> x<tostring($withdraw)> from Engineer Box");
    switch_int (%eb_noted) {
        case 0 : inv_moveitem_uncert(engineer_box, $inv, $obj, $withdraw);
        case default : inv_moveitem_cert(engineer_box, $inv, $obj, $withdraw);
    }
}

[proc,eb_deposit_request](inv $inv, obj $obj, int $amount, int $slot)
def_int $max_per_item = 27;

def_obj $uncert = oc_uncert($obj);
def_int $current = inv_total(engineer_box, $uncert);

if ($current >= $max_per_item) {
    mes("You already have the maximum amount of that component in the box.");
    return;
}

def_int $space_left = sub($max_per_item, $current);
if ($amount > $space_left) {
    $amount = $space_left;
}

if ($amount <= 0) {
    mes("You don't have enough space in your box.");
    return;
}

session_log(^log_moderator,
    "Deposited <oc_debugname($obj)> x<tostring($amount)> into your Engineer Box");

inv_moveitem_uncert($inv, engineer_box, $obj, $amount);

[proc,engineer_box_check_nobreak](obj $obj)(boolean)
if (~engineer_box_find_obj_unbankable($obj) = false) {
    mes("I can't store that here!");
    return(true);
}
if (map_members = false) {
    if ((inv_total(engineer_box, oc_uncert($obj)) = 0) & (sub(inv_size(engineer_box), inv_freespace(engineer_box)) >= ^bank_free_slots)) {
        mes("You need to subscribe for a members account if you want to");
        mes("store any more items in your box.");
        return(true);
    }
}
return(false);

[proc,engineer_box_find_obj_unbankable](obj $obj)(boolean)
switch_obj ($obj) {
        case tin_ore : return(true);
        case copper_ore : return(true);
        case iron_ore : return(true);
        case gold_ore : return(true);
        case silver_ore : return(true);
        case mithril_ore : return(true);
        case adamantite_ore : return(true);
        case runite_ore : return(true);
        case dragon_ore : return(true);

        case bronze_bar : return(true);
        case iron_bar : return(true);
        case silver_bar : return(true);
        case gold_bar : return(true);
        case mithril_bar : return(true);
        case adamantite_bar : return(true);
        case runite_bar : return(true);
        case dragon_bar : return(true);

        case cog : return(true);
        case iron_nails : return(true);
        case barbed_rope : return(true);
        case gunpowder : return(true);
        case bucket_powder : return(true);
        case salt_petre : return(true);
        case bucket_peter : return(true);

        case bronze_rod : return(true);
        case iron_rod : return(true);
        case mithril_rod : return(true);
        case adamant_rod : return(true);
        case rune_rod : return(true);
        case dragon_rod : return(true);

    case default : return(false);
}



