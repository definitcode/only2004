[opheld1,herb_bag] @herb_bag_open(herb_bag);

[inv_button1,hb_side:inv] @herb_bag_deposit(last_slot, 1);
[inv_button2,hb_side:inv] @herb_bag_deposit(last_slot, 5);
[inv_button3,hb_side:inv] @herb_bag_deposit(last_slot, 10);
[inv_button4,hb_side:inv] @herb_bag_deposit(last_slot, ^max_32bit_int);
[inv_button5,hb_side:inv] @herb_bag_deposit(last_slot, null);
[inv_buttond,hb_side:inv] inv_movetoslot(inv, inv, last_slot, last_targetslot);

[inv_button1,hb_main:inv] @herb_bag_withdraw(last_slot, 1);
[inv_button2,hb_main:inv] @herb_bag_withdraw(last_slot, 5);
[inv_button3,hb_main:inv] @herb_bag_withdraw(last_slot, 10);
[inv_button4,hb_main:inv] @herb_bag_withdraw(last_slot, ^max_32bit_int);
[inv_button5,hb_main:inv] @herb_bag_withdraw(last_slot, null);
[inv_buttond,hb_main:inv] inv_movetoslot(herb_bag, herb_bag, last_slot, last_targetslot);

[if_button,hb_main:com_94] %hb_noted = 0;
[if_button,hb_main:com_93] %hb_noted = 1;
[if_close,hb_main] @herb_bag_close;

[label,herb_bag_open](obj $obj)
~clearallq;
if (%gamemode_selected = ^gamemode_uim | %gamemode_selected = ^gamemode_hcuim){
    mes("Ultimate Ironman cannot use Herb Bag!");
    return;
} else if (%gamemode_selected = ^gamemode_pvp | %pk_skull > 0){
    mes("Murderers cannot use Herb Bag!");
    return;
} else if (%druid_progress ! ^druid_complete){
    mes("You need to complete the Druid quest to use Herb Bag.");
    return;
} else if (stat_base(herblore) < 60){
    mes("You need at least level 60 Herblore to use the Herb Bag.");
    return;
}
%hb_noted = 0;
~reorganize_inv(herb_bag);
inv_transmit(inv, hb_side:inv);
inv_transmit(herb_bag, hb_main:inv);
if_openmain_side(hb_main, hb_side);

[label,herb_bag_close]
inv_stoptransmit(hb_side:inv);
inv_stoptransmit(hb_main:inv);
queue(reorganize_herb_bag, 0);

[queue,reorganize_herb_bag]
~reorganize_inv(herb_bag);

[label,herb_bag_deposit](int $slot, int $requested_number)
def_obj $item = inv_getobj(inv, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(inv, $item);
if ($requested_number < $number) $number = $requested_number;
if (~herb_bag_check_nobreak($item) = true) {
    return;
}
~hb_deposit_request(inv, $item, $number, $slot);

[label,herb_bag_withdraw](int $slot, int $requested_number)
def_obj $item = inv_getobj(herb_bag, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(herb_bag, $item);
if ($requested_number < $number) $number = $requested_number;
~hb_withdraw_request(inv, $item, $number, $slot);

[proc,hb_withdraw_request](inv $inv, obj $obj, int $amount, int $slot)
def_obj $cert_or_uncert = oc_uncert($obj);
if (%hb_noted ! 0) {
    $cert_or_uncert = oc_cert($obj);
}
if (%hb_noted = ^true & oc_cert($obj) = $obj) {
    mes("This item can not be withdrawn as a note.");
}
if (inv_itemspace($inv, $cert_or_uncert, $amount, inv_size($inv)) = false){
    if (inv_freespace($inv) = 0) {
        mes("You don't have enough inventory space.");
        return;
    } else if (oc_stackable($cert_or_uncert) = true) {
        mes("You're not going to be able to carry all that!");
    } else {
        mes("You don't have enough inventory space to withdraw that many.");
    }
}
def_int $overflow = inv_itemspace2($inv, $cert_or_uncert, $amount, inv_size($inv));
def_int $withdraw = sub($amount, $overflow);
if ($withdraw > 0) {
    session_log(^log_moderator, "Withdrew <oc_debugname($obj)> x<tostring($withdraw)> from Herb Bag");
    switch_int (%hb_noted) {
        case 0 : inv_moveitem_uncert(herb_bag, $inv, $obj, $withdraw);
        case default : inv_moveitem_cert(herb_bag, $inv, $obj, $withdraw);
    }
}

[proc,hb_deposit_request](inv $inv, obj $obj, int $amount, int $slot)
def_int $max_per_herb = 100;

def_obj $uncert = oc_uncert($obj);
def_int $current = inv_total(herb_bag, $uncert);

if ($current >= $max_per_herb) {
    mes("You already have the maximum amount of that herb in the bag.");
    return;
}

def_int $space_left = sub($max_per_herb, $current);
if ($amount > $space_left) {
    $amount = $space_left;
}

if ($amount <= 0) {
    mes("You don't have enough space in your bag.");
    return;
}

session_log(^log_moderator,
    "Deposited <oc_debugname($obj)> x<tostring($amount)> into your Herb Bag");

inv_moveitem_uncert($inv, herb_bag, $obj, $amount);

[proc,herb_bag_check_nobreak](obj $obj)(boolean)
if (~herb_bag_find_obj_unbankable($obj) = false) {
    mes("I can't store that here!");
    return(true);
}
if (map_members = false) {
    if ((inv_total(herb_bag, oc_uncert($obj)) = 0) & (sub(inv_size(herb_bag), inv_freespace(herb_bag)) >= ^bank_free_slots)) {
        mes("You need to subscribe for a members account if you want to");
        mes("store any more items in your bag.");
        return(true);
    }
}
return(false);

[proc,herb_bag_find_obj_unbankable](obj $obj)(boolean)
switch_obj ($obj) {
    case unidentified_guam_leaf : {return(true);}
    case unidentified_marrentill : {return(true);}
    case unidentified_tarromin : {return(true);}
    case unidentified_harralander : {return(true);}
    case unidentified_ranarr_weed : {return(true);}
    case unidentified_irit_leaf : {return(true);}
    case unidentified_avantoe : {return(true);}
    case unidentified_kwuarm : {return(true);}
    case unidentified_cadantine : {return(true);}
    case unidentified_dwarf_weed : {return(true);}
    case unidentified_torstol : {return(true);}
    case unidentified_lantadyme : {return(true);}
    case unidentified_snake_weed : {return(true);}
    case unidentified_ardrigal : {return(true);}
    case unidentified_sito_foil : {return(true);}
    case unidentified_volencia_moss : {return(true);}
    case unidentified_rogues_purse : {return(true);}
    case guam_leaf : {return(true);}
    case marrentill : {return(true);}
    case tarromin : {return(true);}
    case harralander : {return(true);}
    case ranarr_weed : {return(true);}
    case irit_leaf : {return(true);}
    case avantoe : {return(true);}
    case kwuarm : {return(true);}
    case cadantine : {return(true);}
    case dwarf_weed : {return(true);}
    case torstol : {return(true);}
    case lantadyme : {return(true);}
    case snake_weed : {return(true);}
    case ardrigal : {return(true);}
    case sito_foil : {return(true);}
    case volencia_moss : {return(true);}
    case rogues_purse : {return(true);}
    case default : return(false);
}



