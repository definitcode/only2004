[oploc1,loc_1013] @cooking_shelves_open(loc_1013);

[inv_button1,cs_side:inv] @cooking_shelves_deposit(last_slot, 1);
[inv_button2,cs_side:inv] @cooking_shelves_deposit(last_slot, 5);
[inv_button3,cs_side:inv] @cooking_shelves_deposit(last_slot, 10);
[inv_button4,cs_side:inv] @cooking_shelves_deposit(last_slot, ^max_32bit_int);
[inv_button5,cs_side:inv] @cooking_shelves_deposit(last_slot, null);
[inv_buttond,cs_side:inv] inv_movetoslot(inv, inv, last_slot, last_targetslot);

[inv_button1,cs_main:inv] @cooking_shelves_withdraw(last_slot, 1);
[inv_button2,cs_main:inv] @cooking_shelves_withdraw(last_slot, 5);
[inv_button3,cs_main:inv] @cooking_shelves_withdraw(last_slot, 10);
[inv_button4,cs_main:inv] @cooking_shelves_withdraw(last_slot, ^max_32bit_int);
[inv_button5,cs_main:inv] @cooking_shelves_withdraw(last_slot, null);
[inv_buttond,cs_main:inv] inv_movetoslot(cooking_shelves, cooking_shelves, last_slot, last_targetslot);

[if_button,cs_main:com_94] %cs_noted = 0;
[if_button,cs_main:com_93] %cs_noted = 1;
[if_close,cs_main] @cooking_shelves_close;

[label,cooking_shelves_open](loc $loc)
~clearallq;
if (%gamemode_selected = ^gamemode_uim | %gamemode_selected = ^gamemode_hcuim){
    mes("Ultimate Ironman cannot use Cooking Shelves!");
    return;
} else if (%gamemode_selected = ^gamemode_pvp | %pk_skull > 0){
    mes("Murderers cannot use Cooking Shelves.");
    return;
}
%cs_noted = 0;
~reorganize_inv(cooking_shelves);
inv_transmit(inv, cs_side:inv);
inv_transmit(cooking_shelves, cs_main:inv);
if_openmain_side(cs_main, cs_side);

[label,cooking_shelves_close]
inv_stoptransmit(cs_side:inv);
inv_stoptransmit(cs_main:inv);
queue(reorganize_shelves, 0);

[queue,reorganize_shelves]
~reorganize_inv(cooking_shelves);

[label,cooking_shelves_deposit](int $slot, int $requested_number)
def_obj $item = inv_getobj(inv, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(inv, $item);
if ($requested_number < $number) $number = $requested_number;
if (~cooking_shelves_check_nobreak($item) = true) {
    return;
}
~cs_deposit_request(inv, $item, $number, $slot);

[label,cooking_shelves_withdraw](int $slot, int $requested_number)
def_obj $item = inv_getobj(cooking_shelves, $slot);
if ($requested_number <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested_number = last_int;
}
def_int $number = inv_total(cooking_shelves, $item);
if ($requested_number < $number) $number = $requested_number;
~cs_withdraw_request(inv, $item, $number, $slot);

[proc,cs_withdraw_request](inv $inv, obj $obj, int $amount, int $slot)
def_obj $cert_or_uncert = oc_uncert($obj);
if (%cs_noted ! 0) {
    $cert_or_uncert = oc_cert($obj);
}
if (%cs_noted = ^true & oc_cert($obj) = $obj) {
    mes("This item can not be withdrawn as a note.");
}
if (inv_itemspace($inv, $cert_or_uncert, $amount, inv_size($inv)) = false){
    if (inv_freespace($inv) = 0) {
        mes("You don't have enough inventory space.");
        return;
    } else if (oc_stackable($cert_or_uncert) = true) {
        mes("You're not going to be able to carry all that!");
    } else {
        mes("You don't have enough inventory space to withdraw that many.");
    }
}
def_int $overflow = inv_itemspace2($inv, $cert_or_uncert, $amount, inv_size($inv));
def_int $withdraw = sub($amount, $overflow);
if ($withdraw > 0) {
    session_log(^log_moderator, "Withdrew <oc_debugname($obj)> x<tostring($withdraw)> from Cooking Shelves");
    switch_int (%cs_noted) {
        case 0 : inv_moveitem_uncert(cooking_shelves, $inv, $obj, $withdraw);
        case default : inv_moveitem_cert(cooking_shelves, $inv, $obj, $withdraw);
    }
}

[proc,cs_deposit_request](inv $inv, obj $obj, int $amount, int $slot)
def_int $overflow = inv_itemspace2(cooking_shelves, oc_uncert($obj), $amount, ^max_32bit_int);
if (sub(^max_32bit_int, $amount) < inv_total(cooking_shelves, $obj)) {
    mes("You already have a full stack of that item in the shelves.");
} else if ($overflow >= $amount) {
    mes("You don't have enough space in your cooking shelves.");
    return;
}
def_int $deposit = sub($amount, $overflow);
if ($deposit > 0) {
    session_log(^log_moderator, "Deposited <oc_debugname($obj)> x<tostring($deposit)> into Cooking Shelves");
    inv_moveitem_uncert($inv, cooking_shelves, $obj, $deposit);
}

[proc,cooking_shelves_check_nobreak](obj $obj)(boolean)
if (~cooking_shelves_find_obj_unbankable($obj) = false) {
    mes("I can't store that here!");
    return(true);
}
if (map_members = false) {
    if ((inv_total(cooking_shelves, oc_uncert($obj)) = 0) & (sub(inv_size(cooking_shelves), inv_freespace(cooking_shelves)) >= ^bank_free_slots)) {
        mes("You need to subscribe for a members account if you want to");
        mes("store any more items in the Cooking Shelves.");
        return(true);
    }
}
return(false);

[proc,cooking_shelves_find_obj_unbankable](obj $obj)(boolean)
switch_obj ($obj) {
    case pot_empty : return(true);
    case pot_flour : return(true);
    case bucket_empty : return(true);
    case bucket_water : return(true);
    case vial_empty : return(true);
    case vial_water : return(true);
    case jug_empty : return(true);
    case jug_water : return(true);
    case jug_wine : return(true);
    case pestle_and_mortar : return(true);
    case piedish : return(true);
    case pie_shell : return(true);
    case cake_tin : return(true);
    case bowl_empty : return(true);
    case tinderbox : return(true);
    case pizza_base : return(true);
    case cooking_apple : return(true);
    case lemon : return(true);
    case lemon_chunks : return(true);
    case lemon_slices : return(true);
    case orange : return(true);
    case orange_chunks : return(true);
    case orange_slices : return(true);
    case pineapple : return(true);
    case pineapple_chunks : return(true);
    case pineapple_ring : return(true);
    case lime : return(true);
    case lime_chunks : return(true);
    case lime_slices : return(true);
    case banana : return(true);
    case grapes : return(true);
    case tomato : return(true);
    case onion : return(true);
    case redberry : return(true);
    case cabbage : return(true);
    case potato : return(true);
    case cheese : return(true);
    case bucket_milk : return(true);
    case egg : return(true);
    case chocolate_bar : return(true);
    case chocolate_dust : return(true);
    case chocolaty_milk : return(true);
    case apple_pie : return(true);
    case lemon_pie : return(true);
    case cake : return(true);
    case chocolate_cake : return(true);
    case raw_anchovies : return(true);
    case raw_bear_meat : return(true);
    case raw_beef : return(true);
    case raw_chicken : return(true);
    case raw_shrimp : return(true);
    case raw_sardine : return(true);
    case raw_herring : return(true);
    case raw_trout : return(true);
    case raw_pike : return(true);
    case raw_salmon : return(true);
    case raw_tuna : return(true);
    case raw_lobster : return(true);
    case raw_swordfish : return(true);
    case default : return(false);
}



