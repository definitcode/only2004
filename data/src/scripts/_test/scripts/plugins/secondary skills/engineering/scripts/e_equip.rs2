
[label,levelrequire_fishing](int $level, int $slot)
if (stat_base(fishing) < $level) {
    mes("You are not a high enough level to use this item.");
    mes("You need a Fishing level of <tostring($level)>.");
    return;
}
~equip($slot);

[label,levelrequire_smithing](int $level, int $slot)
if (stat_base(smithing) < $level) {
    mes("You are not a high enough level to use this item.");
    mes("You need a Smithing level of <tostring($level)>.");
    return;
}
~equip($slot);
