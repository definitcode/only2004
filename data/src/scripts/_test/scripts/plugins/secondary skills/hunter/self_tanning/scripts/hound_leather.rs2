[label,craft_hound_cavalier]
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
def_int $feather = inv_total(inv, feather);
if (inv_total(inv, hound_leather) < 2){
    mes("You need 2x Hell Leather to craft this.");
    return;
} else if (inv_total(inv, thread) < 1) {
    mes("You need a thread to do this");
    return;
} else if (inv_total(inv, needle) < 1){
    mes("You need a needle to do this.");
    return;
}
if ($feather < 1){
    return;
} else {
    inv_del(inv, hound_leather, 2);
    inv_del(inv, feather, 1);
    inv_add(inv, hound_cavalier, 1);
    inv_del(inv, thread, 1);
    inv_del(inv, needle, 1);
    mes("You have crafted a Hell Cavalier!");
    stat_advance(crafting, 150);
    if (inv_total(inv, brown_apron) > 0){
        stat_advance(crafting, 150);
        mes("Your crafting skills are showing!");    
    }
    p_delay(1);
    return;
}


[label,craft_hound_leather]
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
if (inv_total(inv, hound_leather) < 1){
    mes("You need Hell Leather to craft with.");
    return;
}
~hound_leather;

[proc,hound_leather]
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
def_int $hound_leather = inv_total(inv, hound_leather);
def_namedobj $choice = ~multiobj4(
    "What would you like to make?", 
    hound_gloves, 0, -2, 185, "Gloves.", 0, 0, 
    hound_boots, 0, 0, 190, "Boots.", 0, 0, 
    hound_body, 0, -20, 175, "Body", 0, 0,
    hound_chaps, 0, -15, 190, "Chaps", 0, 0    
);

switch_namedobj($choice){
    case hound_gloves : {
        if ($hound_leather > 4){
            inv_del(inv, hound_leather, 5);
            ~hand_crafting_action;
            inv_add(inv, hound_gloves, 1);
            ~objbox(hound_gloves, "You have created a pair of Hell Gloves!", 250, 0, 0);
            if ($hound_leather > 4){
                ~hound_leather;
            } else {
                ~mesbox("You need more Hell Leather to craft this.");
            }
        } else {
            ~mesbox("You need more Hell Leather to craft this.");
            return;
        }
    }
    case hound_boots : {
        if ($hound_leather > 9){
            inv_del(inv, hound_leather, 10);
            ~hand_crafting_action;
            inv_add(inv, hound_boots, 1);
            ~objbox(hound_boots, "You have created a pair of Hell Boots!", 250, 0, 20);
            if ($hound_leather > 9){
                ~hound_leather;
            } else {
                ~mesbox("You need more Hell Leather to craft this.");
            }
        } else {
            ~mesbox("You need more Hell Leather to craft this.");
            return;
        }
    }
    case hound_body : {
        if ($hound_leather > 9){
            inv_del(inv, hound_leather, 10);
            ~hand_crafting_action;
            inv_add(inv, hound_body, 1);
            ~objbox(hound_body, "You have created a Hell Body!", 250, 0, 0);
            if ($hound_leather > 9){
                ~hound_leather;
            } else {
                ~mesbox("You need more Hell Leather to craft this.");
            }
        } else {
            ~mesbox("You need more Hell Leather to craft this.");
            return;
        }
    }
    case hound_chaps : {
        if ($hound_leather > 9){
            inv_del(inv, hound_leather, 10);
            ~hand_crafting_action;
            inv_add(inv, hound_chaps, 1);
            ~objbox(hound_chaps, "You have created a pair of Hell Chaps!", 250, 0, 0);
            if ($hound_leather > 9){
                ~hound_leather;
            } else {
                ~mesbox("You need more Hell Leather to craft this.");
                return;
            }
        } else {
            ~mesbox("You need more Hell Leather to craft this.");
            return;
        }
    }
}