[proc,plague_check]()(int)
def_int $item_count;
if (inv_total(worn, gasmask) > 0){
    $item_count = calc($item_count + 1);
}
if (inv_total(worn, gasmask_i) > 0){
    $item_count = calc($item_count + 1);
}
if (inv_total(worn, plague_trousers) > 0){
    $item_count = calc($item_count + 1);
}
if (inv_total(worn, plague_jacket) > 0){
    $item_count = calc($item_count + 1);
}
return($item_count);



[proc,cut_shroom](int $multi, int $exp)
def_int $freespace = inv_freespace(inv);
if ($freespace < 1) {
    mes("You don't have enough inventory space to cut the mushroom.");
    return;
}
def_int $plague_check = ~plague_check;
if ($plague_check > 2) {
    $multi = calc($multi + random(4));
    anim(human_pickupfloor, 0);
    p_delay(1);
    inv_add(inv, mushroom, $multi);
    stat_advance(herblore, $exp);
    loc_del(1200);
} else {
    damage(uid, 1, 10);
    anim(human_axe_block, 0);
    loc_anim(gas);
    mes("You breath in toxic spores...");
    mes("The gas burns your skin!");
    queue(poison_player, 0, 27);
}

[proc,cut_daisys](int $multi, int $exp)
def_int $freespace = inv_freespace(inv);
if ($freespace < 1) {
    mes("You don't have enough inventory space to cut the daisies.");
    return;
}
$multi = calc($multi + random(4));
anim(human_pickupfloor, 0);
p_delay(1);
inv_add(inv, flowers_white, $multi);
stat_advance(herblore, $exp);
loc_del(60);

