[proc,cut_tree_stump](int $multi, int $exp)
def_int $freespace = inv_freespace(inv);
if ($freespace < 1) {
    mes("You don't have enough inventory space to remove the stump.");
    return;
}

$multi = calc($multi + random(4));
anim(human_pickupfloor, 0);
sound_synth(woodchop, 2, 0);
p_delay(1);
anim(human_pickupfloor, 0);
sound_synth(woodchop, 2, 0);
p_delay(1);
loc_del(600);
inv_add(inv, tree_bark, $multi);
stat_advance(woodcutting, $exp);

