[label,harvesting](loc $loc)
def_int $multi;
def_int $exp;
def_obj $shears = ~shear_checker_herb;

if ($shears = null){
    mes("You don't have any shears.");
    return;
}
switch_obj($shears){
    case shears : {
        $multi = 1;
        $exp = 50;
    }
    case bronze_shears : {
        $multi = 2;
        $exp = 100;
    }
    case iron_shears : {
        $multi = 3;
        $exp = 150;
    }
    case steel_shears : {
        $multi = 4;
        $exp = 200;
    }
    case adamant_shears : {
        $multi = 5;
        $exp = 250;
    }
    case rune_shears : {
        $multi = 6;
        $exp = 300;
    }
    case dragon_shears : {
        $multi = 7;
        $exp = 350;
    }
}
switch_loc($loc){
    // Mushrooms & Fungus
    case loc_1163 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1164 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1165 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1166 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1167 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1168 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1169 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1170 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1171 : {
        ~cut_shroom($multi, $exp);
    }
    case loc_1172 : {
        ~cut_shroom($multi, $exp);
    }
    // Flowers
    case daisys : {
        ~cut_daisys($multi, 120);
    }
}



[label,stump_removal](loc $loc)
def_int $multi;
def_int $exp;
if (~woodcutting_axe_checker(true) = null) {
    mes("You don't have an axe.");
    return;
}
p_oploc(1);
switch_obj(~woodcutting_axe_checker(true)){
    case dragon_axe : {
        $multi = 7;
        $exp = 350;
    }
    case rune_axe : {
        $multi = 6;
        $exp = 300;
    }
    case adamant_axe : {
        $multi = 5;
        $exp = 250;
    }
    case mithril_axe : {
        $multi = 4;
        $exp = 200;
    }
    case black_axe : {
        $multi = 3;
        $exp = 150;
    }
    case steel_axe : {
        $multi = 2;
        $exp = 100;
    }
    case iron_axe : {
        $multi = 1;
        $exp = 50;
    }
    case bronze_axe : {
        $multi = 1;
        $exp = 50;
    }
    case founders_axe : {
        $multi = 1;
        $exp = 50;
    }
}

