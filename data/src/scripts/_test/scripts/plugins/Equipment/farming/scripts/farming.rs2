        ~cut_tree_stump($multi, $exp);
    }
    case loc_1348 : {
        ~cut_tree_stump($multi, $exp);
    }
    case loc_1349 : {
        ~cut_tree_stump($multi, $exp);
    }
    case loc_1350 : {
        ~cut_tree_stump($multi, $exp);
    }
    case loc_1351 : {
        ~cut_tree_stump($multi, $exp);
    }
    case loc_1352 : {
        ~cut_tree_stump($multi, $exp);
    }
    case loc_1353 : {
        ~cut_tree_stump($multi, $exp);
    }
    case loc_1354 : {
        ~cut_tree_stump($multi, $exp);
    }
    case oak_tree_stump : {
