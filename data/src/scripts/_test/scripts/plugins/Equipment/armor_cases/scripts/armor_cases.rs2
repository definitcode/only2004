    }
    case iron_armor_case_lg : {
        inv_del(inv, iron_armor_case_lg, 1);
        inv_add(inv, iron_full_helm, 1);
        inv_add(inv, iron_platebody, 1);
        inv_add(inv, iron_platelegs, 1);
        inv_add(inv, empty_casket, 1);
    }
    case bronze_armor_case_lg : {
        inv_del(inv, bronze_armor_case_lg, 1);
        inv_add(inv, bronze_full_helm, 1);
        inv_add(inv, bronze_platebody, 1);
        inv_add(inv, bronze_platelegs, 1);
        inv_add(inv, empty_casket, 1);
    }
    case bronze_armor_case_sk : {
        inv_del(inv, bronze_armor_case_sk, 1);
        inv_add(inv, bronze_full_helm, 1);
        inv_add(inv, bronze_platebody, 1);
        inv_add(inv, bronze_plateskirt, 1);
        inv_add(inv, empty_casket, 1);
    }
}
mes("You just opened your <oc_param($armor_case, name)>!");

[proc,dragon_armorlg_checker]()(boolean)
def_int $full_helm = inv_total(inv, dragon_full_helm);
def_int $platebody = inv_total(inv, dragon_platebody);
def_int $platelegs = inv_total(inv, dragon_platelegs);

if($full_helm > 0 & $platebody > 0 & $platelegs > 0 ){
    return(true);
}
return(false);

