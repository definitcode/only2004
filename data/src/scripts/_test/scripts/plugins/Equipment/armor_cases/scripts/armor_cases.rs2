        inv_del(inv, rune_armor_case_lgt, 1);
        inv_add(inv, rune_full_helm_gold, 1);
        inv_add(inv, rune_platebody_gold, 1);
        inv_add(inv, rune_platelegs_gold, 1);
        inv_add(inv, rune_kiteshield_gold, 1);
        inv_add(inv, empty_casket, 1);
