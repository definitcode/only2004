[label,load_case](obj $armor)
if (%engineering < 150){
    mes("You need an engineering level of 150 to do this.");
    return;
}
if (%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
switch_obj($armor){
    //dragon
    case dragon_full_helm : {
        if (~dragon_armorlg_checker = true){
            inv_del(inv, dragon_full_helm, 1);
            inv_del(inv, dragon_platebody, 1);
            inv_del(inv, dragon_platelegs, 1);
