[label,open_case](obj $armor_case)
switch_obj($armor_case){
    case dragon_armor_case_lg : {
        inv_del(inv, dragon_armor_case_lg, 1);
        inv_add(inv, dragon_full_helm, 1);
        inv_add(inv, dragon_platebody, 1);
        inv_add(inv, dragon_platelegs, 1);
        inv_add(inv, empty_casket, 1);
    }
    case dragon_armor_case_sk : {
        inv_del(inv, dragon_armor_case_sk, 1);
        inv_add(inv, dragon_full_helm, 1);
        inv_add(inv, dragon_platebody, 1);
        inv_add(inv, dragon_plateskirt, 1);
        inv_add(inv, empty_casket, 1);
    }
    case dragon_armor_case_lgt : {
        inv_del(inv, dragon_armor_case_lgt, 1);
        inv_add(inv, dragon_full_helm_gold, 1);
        inv_add(inv, dragon_platebody_gold, 1);
        inv_add(inv, dragon_platelegs_gold, 1);
        inv_add(inv, dragon_kiteshield_gold, 1);
        inv_add(inv, empty_casket, 1);
    }
    case rune_armor_case_lg : {
        inv_del(inv, rune_armor_case_lg, 1);
        inv_add(inv, rune_full_helm, 1);
        inv_add(inv, rune_platebody, 1);
        inv_add(inv, rune_platelegs, 1);
        inv_add(inv, empty_casket, 1);
    }
    case rune_armor_case_sk : {
        inv_del(inv, rune_armor_case_sk, 1);
        inv_add(inv, rune_full_helm, 1);
        inv_add(inv, rune_platebody, 1);
        inv_add(inv, rune_plateskirt, 1);
        inv_add(inv, empty_casket, 1);
    }
