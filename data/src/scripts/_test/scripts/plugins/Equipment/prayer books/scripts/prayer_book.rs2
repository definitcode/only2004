[opheld2,book_of_prayers] @cast_prayer;
[opheld2,unfinished_book_of_chaos] @finish_chaos_book;

[label,finish_chaos_book]
def_int $page_count = 0;
if (inv_total(inv, enscribed_page1) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page2) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page3) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page4) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page5) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page6) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page7) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page8) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page9) > 0){
    $page_count = add($page_count, 1);
}
if (inv_total(inv, enscribed_page10) > 0){
    $page_count = add($page_count, 1);
}
if ($page_count = 10){
    if (inv_total(inv, unfinished_book_of_chaos) > 0){
        inv_del(inv, unfinished_book_of_chaos, 1);
        inv_del(inv, enscribed_page1, 1);        
        inv_del(inv, enscribed_page2, 1);
        inv_del(inv, enscribed_page3, 1);
        inv_del(inv, enscribed_page4, 1);
        inv_del(inv, enscribed_page5, 1);
        inv_del(inv, enscribed_page6, 1);
        inv_del(inv, enscribed_page7, 1);
        inv_del(inv, enscribed_page8, 1);
        inv_del(inv, enscribed_page9, 1); 
        inv_del(inv, enscribed_page10, 1);
        inv_add(inv, book_of_chaos, 1);
        mes("You have crafted the Book of Chaos.");       
    }
}
// Cast Prayer Ritual
[label,cast_prayer]
def_int $max_prayer = add(stat_base(prayer), 15);
def_int $burnt_bones = inv_total(inv, bones_burnt);

// Check bones
if ($burnt_bones < 4) {
    mes("You do not have enough Burnt bones to do the ritual.");
    return;
}

// Already boosted to max or higher
if (stat(prayer) >= $max_prayer) {
    mes("You need to wait before making another prayer!");
    return;
}

// Only allow if current prayer is below base (meaning drained)
if (stat(prayer) <= stat_base(prayer)) {
    def_int $random = random(10);
    def_string $prayer = "No Prayer";

    switch_int($random){
        case 0 : $prayer = "Ignis Voco Tempra";
        case 1 : $prayer = "Umbra Nex Mortem";
        case 2 : $prayer = "Sanctus Lux Veni";
        case 3 : $prayer = "Draco Silex Frangere";
        case 4 : $prayer = "Tempus Ardet Caeli";
        case 5 : $prayer = "Frigus Tenebris Clamare";
        case 6 : $prayer = "Vita Cruor Acceptum";
        case 7 : $prayer = "Aqua Serpentis Dormi";
        case 8 : $prayer = "Volatus Vox Umbrae";
        case 9 : $prayer = "Ordo Flammae Vindicta";
    }

    inv_del(inv, bones_burnt, 4);
    sound_synth(high_alchemy, 0, 0);
    anim(human_castlowlvlalchemy, 1);
    spotanim_pl(lowlvlalchemy_casting, 92, 0);
    say("<$prayer>");
    stat_boost(prayer, 1, 15);
    p_delay(3);
}
else {
    mes("You have already uttered this incantation, you must wait.");
}



[label,meleeprayer]

if (p_finduid(uid) = true) {
    ~activate_prayer_protectfrommelee;
}
%prayer_protectfrommelee = %prayer_protectfrommelee;

[label,rangedprayer]

if (p_finduid(uid) = true) {
    ~activate_prayer_protectfrommissiles;
}
%prayer_protectfrommissiles = %prayer_protectfrommissiles;

[label,magicprayer]

if (p_finduid(uid) = true) {
    ~activate_prayer_protectfrommagic;
}
%prayer_protectfrommagic = %prayer_protectfrommagic;


[proc,activate_prayer_protectfrommelee]
//p_clearpendingaction;
def_dbrow $data = ~get_prayer_data(^prayer_protectfrommelee);
if ($data = null) {
    return;
}
if (%prayer_protectfrommelee = ^true) {
    %prayer_protectfrommelee = ^false;
    ~prayer_deactivate(^prayer_protectfrommelee);
    return;
}
if (~prayer_checks($data) = false) {
    %prayer_protectfrommelee = ^false;
    return;
}
def_int $levelreq = db_getfield($data, prayers:level, 0);
if (stat_base(prayer) < $levelreq){
    %prayer_protectfrommelee = ^false;
    sound_synth(prayer_off, 0, 0);
    ~mesbox("You need a @dbl@Prayer level of <tostring($levelreq)> to use <db_getfield($data, prayers:name, 0)>.");
    return;
}
%prayer_protectfrommelee = ^true;
~prayer_activate($data);

