[proc,skilling_container_drops]
if (inv_total(inv, bucket_fish) > 0){
    ~fish_drop;
}
if (inv_total(inv, bar_box) > 0){
    ~bar_drop;
}
if (inv_total(inv, ore_box2) > 0){
    ~ore_drop;
}
if (inv_total(inv, herb_bag) > 0){
    ~herb_drop;
}
[proc,fish_drop]
def_int $lobster_count = %lobster_count;
def_int $swordfish_count = %swordfish_count;
def_int $tuna_count = %tuna_count;
def_int $shark_count  = %shark_count;
if ($tuna_count > 0){
    obj_add(coord, cert_raw_tuna, $tuna_count, ^lootdrop_duration);
}
if ($lobster_count > 0){
    obj_add(coord, cert_raw_lobster, $lobster_count, ^lootdrop_duration);
}
if ($swordfish_count > 0){ 
    obj_add(coord, cert_raw_swordfish, $swordfish_count, ^lootdrop_duration);
}
if ($shark_count > 0){ 
    obj_add(coord, cert_raw_shark, $shark_count, ^lootdrop_duration);
}
inv_del(inv, bucket_fish, 1);
mes("Your Bucket of fish has been destroyed!");
%lobster_count = 0;
%swordfish_count = 0;
%tuna_count = 0;
%shark_count = 0;


/// ORE DROP
[proc,ore_drop]
def_int $tin_ore_count      = %tin_ore_count;
def_int $copper_ore_count   = %copper_ore_count;
def_int $iron_ore_count     = %iron_ore_count;
def_int $gold_ore_count     = %gold_ore_count;
def_int $silver_ore_count   = %silver_ore_count;
def_int $coal_ore_count     = %coal_ore_count;
def_int $mithril_ore_count  = %mithril_ore_count;
def_int $adamant_ore_count  = %adamant_ore_count;
def_int $rune_ore_count     = %rune_ore_count;
def_int $dragon_ore_count   = %dragon_ore_count;
if ($tin_ore_count > 0)     { obj_add(coord, cert_tin_ore, $tin_ore_count, ^lootdrop_duration); }
if ($copper_ore_count > 0)  { obj_add(coord, cert_copper_ore, $copper_ore_count, ^lootdrop_duration); }
if ($iron_ore_count > 0)    { obj_add(coord, cert_iron_ore, $iron_ore_count, ^lootdrop_duration); }
if ($gold_ore_count > 0)    { obj_add(coord, cert_gold_ore, $gold_ore_count, ^lootdrop_duration); }
if ($silver_ore_count > 0)  { obj_add(coord, cert_silver_ore, $silver_ore_count, ^lootdrop_duration); }
if ($coal_ore_count > 0)    { obj_add(coord, cert_coal, $coal_ore_count, ^lootdrop_duration); }
if ($mithril_ore_count > 0) { obj_add(coord, cert_mithril_ore, $mithril_ore_count, ^lootdrop_duration); }
if ($adamant_ore_count > 0) { obj_add(coord, cert_adamantite_ore, $adamant_ore_count, ^lootdrop_duration); }
if ($rune_ore_count > 0)    { obj_add(coord, cert_runite_ore, $rune_ore_count, ^lootdrop_duration); }
if ($dragon_ore_count > 0)  { obj_add(coord, cert_dragon_ore, $dragon_ore_count, ^lootdrop_duration); }
inv_del(inv, ore_box2, 1);
mes("Your Ore Box has been destroyed!");
%tin_ore_count = 0;
%copper_ore_count = 0;
%iron_ore_count = 0;
%gold_ore_count = 0;
%silver_ore_count = 0;
%coal_ore_count = 0;
%mithril_ore_count = 0;
%adamant_ore_count = 0;
%rune_ore_count = 0;
%dragon_ore_count = 0;



