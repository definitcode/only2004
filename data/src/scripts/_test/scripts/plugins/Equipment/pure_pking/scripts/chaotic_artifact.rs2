    }
    case dragon_dagger_p : {
        def_int $dmg = random(25);
        anim(human_scythe_spin, 0);
        spotanim_npc(curse_impact, 120, 0);
        mes("You unleash the fury of your dagger!");
        
        // Combat Sync (Player Side)
        %lastcombat = map_clock;
        %aggressive_npc = $uid;
        
        // Retaliate & Damage (NPC Side)
        // We use ~ to inherit context but no dot since it's a proc
        ~npc_retaliate(0);
        ~npc_default_damage($dmg);
        
        // Visuals (NPC Context)
        npc_anim(npc_param(defend_anim), 20);
        npc_anim(zap, 0);
        spotanim_npc(enfeeble_impact, 120, 0);
        %special_attack = calc(%special_attack - 50);
        mes("Special Attack: <tostring(%special_attack)>");
        p_delay(1);
    }
    case rogue_dagger : {
        def_int $dmg = random(8);
        anim(human_ddagger_lunge, 0);
        mes("You strike with a lethal rogue's precision!");
        
        // Combat Sync (Player Side)
        %lastcombat = map_clock;
        %aggressive_npc = $uid;
        
        // Retaliate & Damage (NPC Side)
        ~npc_retaliate(0);
        ~npc_default_damage($dmg);
        
        // Visuals (NPC Context)
        npc_anim(npc_param(defend_anim), 20);
        npc_anim(human_pray, 0);
        spotanim_npc(enfeeble_impact, 120, 0);
        %special_attack = calc(%special_attack - 50);
        mes("Special Attack: <tostring(%special_attack)>");
        p_delay(1);
    }
    case rogue_dagger_p : {
        def_int $dmg = random(8);
        anim(human_ddagger_lunge, 0);
        spotanim_npc(curse_impact, 120, 0);
        mes("You strike with a lethal rogue's precision!");
        
        // Combat Sync (Player Side)
        %lastcombat = map_clock;
        %aggressive_npc = $uid;
        
        // Retaliate & Damage (NPC Side)
        ~npc_retaliate(0);
        ~npc_default_damage($dmg);
        
        // Visuals (NPC Context)
        npc_anim(npc_param(defend_anim), 20);
        npc_anim(human_pray, 0);
        spotanim_npc(enfeeble_impact, 120, 0);
        %special_attack = calc(%special_attack - 50);
        mes("Special Attack: <tostring(%special_attack)>");
        p_delay(1);
    }
    case paladin_hammer : {
        def_int $dmg = random(15);
        spotanim_npc(saradomin_lightning, 100, 0);
        spotanim_pl(saradomin_lightning, 100, 0);
        anim(human_blunt_pound, 0);
        mes("You invoke the frozen power of the Zeal!");
        
        // Combat Sync (Player Side)
        %lastcombat = map_clock;
        %aggressive_npc = $uid;
        
        // Retaliate & Damage (NPC Side)
        ~npc_retaliate(0);
        ~npc_default_damage($dmg);
        
        // Visuals (NPC Context)
        npc_anim(npc_param(defend_anim), 20);
        npc_anim(zap, 0);
        spotanim_npc(enfeeble_impact, 120, 3);
        %special_attack = calc(%special_attack - 50);
        mes("Special Attack: <tostring(%special_attack)>");
