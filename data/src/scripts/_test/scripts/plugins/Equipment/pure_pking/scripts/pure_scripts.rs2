[proc,drunkmonk_pure]
if (inv_freespace(inv) > 13) {
    // Bear gear for rogue (req 30 str/ranged)
    inv_add(inv, stringstar, 1);
    inv_add(inv, monkrobetop, 1);
    inv_add(inv, monkrobebottom, 1);
    inv_add(inv, leather_gloves, 1);
    inv_add(inv, plainstaff, 1); // Black dagger (req 35 attack)
    inv_add(inv, beer, 3);
    inv_add(inv, cert_trout, 10);
    inv_add(inv, pvp_badge, 1);
    inv_del(inv, pk_box, 1);
    ~stat_push;
} else {
    mes("You need at least 14 inventory slots free.");
}
// Equipment Checker
[label,pure_check_slot](int $slot)
if (stat_base(hitpoints) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(prayer) > 35){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(magic) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(attack) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(strength) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(defence) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(ranged) > 50){
    mes("Your stat's are too high to open this.");
    return;
}
~equip($slot);


[proc,resurrection_gear]
inv_add(inv, priest_gown, 1);
inv_add(inv, priest_robe, 1);


[proc,bloody_casket]
inv_del(inv, bloody_casket, 1);
def_int $random = random(128);
if ($random < 5) {
    inv_add(inv, bloody_coins, 5);
} else if ($random < 9) {
    inv_add(inv, bloody_coins, 10);
} else if ($random < 12) {
    inv_add(inv, bloody_coins, 15);
} else if ($random < 14) {
    inv_add(inv, steel_arrow, 20);
} else if ($random < 20) {
    inv_add(inv, chaosrune, 15);
} else if ($random < 23) {
    inv_add(inv, bloody_coins, 30);
} else if ($random < 26) {
    inv_add(inv, waterrune, 35);
} else if ($random < 29) {
    inv_add(inv, lawrune, 10);
} else if ($random < 31) {
    inv_add(inv, steel_arrow, 20);
} else if ($random < 33) {
    inv_add(inv, mindrune, 50);
} else if ($random < 35) {
    inv_add(inv, cosmicrune, 5);
} else if ($random < 37) {
    inv_add(inv, naturerune, 10);
} else if ($random < 38) {
    inv_add(inv, airrune, 50);
} else if ($random < 39) {
    inv_add(inv, earthrune, 15);
} else if ($random < 46) {
    inv_add(inv, ~randomherb);
} else if ($random < 60) {
    inv_add(inv, bloody_coins, 53);
} else if ($random < 68) {
    inv_add(inv, bloody_coins, 150);
} else if ($random < 70) {
    inv_add(inv, bloody_coins, 52);
} else if ($random < 74) {
    inv_add(inv, bloody_coins, 80);
} else if ($random < 76) {
    inv_add(inv, bloody_coins, 88);
} else if ($random < 87) {
    inv_add(inv, steel_crossbow, 1);
} else if ($random < 93) {
    inv_add(inv, sapphire_bolt, 20);
} else if ($random < 95) {
    inv_add(inv, black_scimitar, 1);
} else if ($random < 96){
    inv_add(inv, agility_token, 1);
} else if ($random < 98) {
    inv_add(inv, ~randomjewel);
    inv_add(inv, ~randomjewel);
    inv_add(inv, ~grindingtable);
} else if ($random < 100) {
    inv_add(inv, ~mid_tier_items);
}



