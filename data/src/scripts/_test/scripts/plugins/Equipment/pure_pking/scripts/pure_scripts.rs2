    inv_add(inv, leather_gloves, 1);
    inv_add(inv, leather_boots, 1);
    inv_add(inv, pvp_badge, 1);
    inv_add(inv, tank_kiteshield, 1);
    inv_add(inv, tank_warhammer, 1);  // Black warhammer (req 35 attack)
    inv_add(inv, iron_2h_sword, 1);   // Black 2h sword (req 35 attack)
    inv_add(inv, cert_trout, 10);
    inv_del(inv, pk_box, 1);
    ~stat_push;
} else {
    mes("You need at least 14 inventory slots free.");
}

[proc,rogue_pure]
if (inv_freespace(inv) > 13) {
    // Bear gear for rogue (req 30 str/ranged)
    inv_add(inv, bear_coif, 1);
    inv_add(inv, bear_body, 1);
    inv_add(inv, bear_boots, 1);
    inv_add(inv, bear_gloves, 1);
    inv_add(inv, bear_cape, 1);
    inv_add(inv, bear_chaps, 1);
    inv_add(inv, rogue_dagger, 1); // Black dagger (req 35 attack)
    inv_add(inv, iron_dart_p, 1);
    inv_add(inv, rogue_magnet, 1);
    inv_add(inv, weapon_poison, 1);
    inv_add(inv, 4doseantipoison, 1);
    inv_add(inv, cert_trout, 10);
    inv_add(inv, pvp_badge, 1);
    inv_del(inv, pk_box, 1);
    ~stat_push;
} else {
    mes("You need at least 14 inventory slots free.");
}

// Equipment Checker
[label,pure_check_slot](int $slot)
if (stat_base(hitpoints) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(prayer) > 35){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(magic) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(attack) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(strength) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(defence) > 50){
    mes("Your stat's are too high to open this.");
    return;
} else if (stat_base(ranged) > 50){
    mes("Your stat's are too high to open this.");
    return;
}
~equip($slot);


[proc,resurrection_gear]
inv_add(worn, priest_gown, 1);
inv_add(worn, priest_robe, 1);
inv_add(inv, herring, 5);