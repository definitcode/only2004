[label,max_cape_interface](string $message)
def_int $imbued_dust = inv_total(inv, imbued_dust);
def_obj $item = last_item;
def_int $slot = last_slot;
if ($imbued_dust < 500) {
    mes("You need at least 500 Imbued Dust to Teleport!");
    return;
}
def_int $choice = ~p_choice5_header("Edgeville.", 1, "Dueling Arena.", 2, "Brimhaven.", 3, "KBD.", 4, "Zanaris.", 5, "Where would you like to teleport to ?");

if (~wilderness_level(coord) > 0) {
    // osrs
    mes("A mysterious force blocks your teleport.");
    mes("You can't use this teleport in the wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
mes($message);
switch_int($choice) {
    case 1 : 
        ~player_teleport_normal(0_48_54_15_40);
        inv_del(inv, imbued_dust, 500);
    case 2 : 
        ~player_teleport_normal(map_findsquare(0_51_50_51_35, 0, 2, ^map_findsquare_lineofwalk));
        inv_del(inv, imbued_dust, 500);
    case 3 : 
        ~player_teleport_normal(0_43_49_50_41);
        inv_del(inv, imbued_dust, 500);
    case 4 : 
        ~player_teleport_normal(0_46_60_62_10);
        inv_del(inv, imbued_dust, 500);
    case 5 : 
        ~player_teleport_normal(0_50_149_49_20);
        inv_del(inv, imbued_dust, 500);
}

[label,skill_cape_teleport_simple](string $dest_name, coord $dest_coord)
def_int $imbued_dust = inv_total(inv, imbued_dust);
if ($imbued_dust < 500) {
    mes("You need at least 500 Imbued Dust to Teleport!");
    return;
}
if (~wilderness_level(coord) > 0) {
    mes("A mysterious force blocks your teleport.");
    mes("You can't use this teleport in the wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
mes("You teleport to <$dest_name>.");
inv_del(inv, imbued_dust, 500);
~player_teleport_normal($dest_coord);

[label,agility_cape_teleport]
def_int $imbued_dust = inv_total(inv, imbued_dust);
if ($imbued_dust < 500) {
    mes("You need at least 500 Imbued Dust to Teleport!");
    return;
}
if (~wilderness_level(coord) > 0) {
    mes("A mysterious force blocks your teleport.");
    mes("You can't use this teleport in the wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}

def_int $choice = ~p_choice2_header("Gnome Course.", 1, "Barbarian Course.", 2, "Where would you like to go?");
switch_int($choice) {
    case 1 : {
        mes("You teleport to the Gnome Course.");
        inv_del(inv, imbued_dust, 500);
        ~player_teleport_normal(0_38_53_38_44); // Filler
    }
    case 2 : {
        mes("You teleport to the Barbarian Course.");
        inv_del(inv, imbued_dust, 500);
        ~player_teleport_normal(0_39_55_56_41); // Filler
    }
}

