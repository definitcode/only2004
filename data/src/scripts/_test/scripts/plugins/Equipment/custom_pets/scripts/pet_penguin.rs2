    }
    case raw_shark : {
        inv_del(inv, raw_shark, 1);
        mes("You feed the penguin a raw shark.");
        anim(human_pickuptable, 0);        
    }
    case raw_sardine : {
        inv_del(inv, raw_sardine, 1);
        mes("You feed the penguin a raw sardine.");
        anim(human_pickuptable, 0);        
    }
    case raw_giant_carp : {
        inv_del(inv, raw_giant_carp, 1);
        mes("You feed the penguin a raw giant carp.");
        anim(human_pickuptable, 0);        
    }
    case raw_cod : {
        inv_del(inv, raw_cod, 1);
        mes("You feed the penguin a raw cod.");
        anim(human_pickuptable, 0);        
    }
    case raw_herring : {
        inv_del(inv, raw_herring, 1);
        mes("You feed the penguin a raw herring.");
        anim(human_pickuptable, 0);        
    
    }
    case raw_pike : {
        inv_del(inv, raw_pike, 1);
        mes("You feed the penguin a raw pike.");
        anim(human_pickuptable, 0);        
    }
    case raw_mackerel : {
        inv_del(inv, raw_mackerel, 1);
        mes("You feed the penguin a raw mackerel.");
        anim(human_pickuptable, 0);
        
    }
    case raw_bass : {
        inv_del(inv, raw_bass, 1);
        mes("You feed the penguin a raw bass.");
        anim(human_pickuptable, 0);
    
