[opheld1,penguin_whistle] @penguin_drop;
[opnpcu,pet_penguin]
switch_obj(last_useitem){
    case raw_shrimp : {
        inv_del(inv, raw_shrimp, 1);
        mes("You feed the penguin a raw shrimp.");
        anim(human_pickuptable, 0);        
    }
    case raw_anchovies : {
        inv_del(inv, raw_anchovies, 1);
        mes("You feed the penguin a raw anchovy.");
        anim(human_pickuptable, 0);        
    }
