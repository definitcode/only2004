        anim(human_pickuptable, 0);
        
    }
    case raw_seaturtle : {
        inv_del(inv, raw_seaturtle, 1);
        mes("You feed the penguin a raw seaturtle.");
        anim(human_pickuptable, 0);        
    }
    case default : {
        mes("The penguin ignores you.");
        return;
    }
}

[ai_timer,pet_penguin]
def_int $random = random(3);
switch_int($random) {
    case 0 : npc_say("I wish it was colder..");
    case 1 : npc_say("Feed me, human!");
    case 2 : npc_say("Tfw no penguin gf");
    case 3 : npc_say("Carry me, my feet are tired");
}

[label,penguin_drop]
if (map_members = false) {
    mes(^mes_members_do_that); //todo: verify if there is a specific message for trying to drop in f2p
    return;
}
if (npc_finduid(%follower_uid) = true) {
    mes("You already have a follower."); //osrs
    return;
}
inv_delslot(inv, last_slot);
sound_synth(put_down, 0, 0);
~penguin_spawn(oc_param(last_item, follower_id));

[proc,penguin_spawn](npc $type)
npc_add(coord, $type, ^max_32bit_int);
%follower_obj = nc_param(npc_type, pet_item_id);
%follower_uid = npc_uid;
%npc_attacking_uid = uid;
npc_setmode(playerfollow);
npc_say("OUCH! You dropped me!");
npc_settimer(30);

