[opheldu,trimming_kit_g] @attempt_armor_trimming(last_useitem);


[label,attempt_armor_trimming](obj $last_item)
if (%engineering < 200){
    mes("You need an engineering level of 200 to do this.");
    return;
}
switch_obj($last_item){

    case rune_scimitar : {
        if (inv_total(inv, gold_bar) > 0){
            inv_del(inv, $last_item, 1);
            inv_del(inv, gold_bar, 1);
            ~hand_crafting_action;
            stat_advance(crafting, 250);
            inv_add(inv, guilded_scimitar, 1);
        } else {
            mes("You need a gold bar to do this.");
        }
    }
    case black_platebody : {
        if (inv_total(inv, gold_bar) > 0){
            inv_del(inv, $last_item, 1);
            inv_del(inv, gold_bar, 1);
            ~hand_crafting_action;
            stat_advance(crafting, 250);
            inv_add(inv, black_platebody_trim, 1);
        } else {
            mes("You need a gold bar to do this.");
        }
    }
