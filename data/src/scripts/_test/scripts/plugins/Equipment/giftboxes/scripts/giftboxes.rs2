[opheld1,gift_box] ~open_giftbox;
[opheld1,gamble_box] @dice_games;
[opheld1,reset_box] ~reset;
[opheld1,hc_box] ~hc_box;
[opheld1,alchemy_box] ~alchemy_box;
[opheld1,allgear_box] ~rolltester;
[opheld1,scythe_box] ~scythe_box_open;
[opheld1,halberd_box] ~halberd_box_open;
[opheld1,christmas_present] ~christmas_present;
[opheld1,new_year_cracker] ~new_year_cracker;
[opheld1,halloween_box] ~halloween_box;

[proc,christmas_present]
if (inv_freespace(inv) > 3){
    inv_add(inv, penguin_whistle, 1);
    inv_add(inv, snowball_mould, 1);
    inv_add(inv, santa_hat, 1);
    inv_add(inv, lump_of_coal, 1);
    inv_del(inv, christmas_present, 1);
    %christmas = 1;
} else {
    mes("You need 4 spaces free to open this");
}

[proc,halloween_box]
if (inv_freespace(inv) > 3){
    inv_add(inv, scythe, 1);
    inv_add(inv, pumpkin, 1);
    inv_add(inv, pet_death_wing, 1);
    switch_int(random(2)){
        case 0 : {
            inv_add(inv, halloweenmask_blue, 1);
        }
        case 1 : {
            inv_add(inv, halloweenmask_red, 1);
        }
        case 2 : {
            inv_add(inv, halloweenmask_green, 1);
        }
    }
    inv_del(inv, halloween_box, 1);
    %halloween = 1;
} else {
    mes("You need 4 spaces free to open this");
}


[proc,new_year_cracker]
if (inv_freespace(inv) > 3){
    spotanim_pl(levelup_anim, 120, 0);
    inv_add(inv, beer, 1);
    inv_del(inv, new_year_cracker, 1);
    say("Wooo! Happy New Year!");
    %newyearseve = 1;
}

[proc,scythe_box_open]
if (inv_freespace(inv) > 0){
    inv_add(inv,scythe, 1);
    inv_del(inv,scythe_box, 1);
    mes("You have received a Scythe!");
}
[proc,halberd_box_open]
if (inv_freespace(inv) > 0){
    inv_add(inv,halberd, 1);
    inv_del(inv,halberd_box, 1);
    mes("You have received a Halberd!");
}

[proc,open_giftbox]
if (inv_freespace(inv) > 3){

    def_int $random = random(4);

    switch_int($random){
        case 1 : {
            inv_add(inv, scythe, 1);
            inv_del(inv, gift_box, 1);
        }
        case 2 : {
            inv_add(inv, bunnyears, 1);
            inv_del(inv, gift_box, 1);
        }
        case 3 : {
            inv_add(inv, santa_hat, 1);
            inv_del(inv, gift_box, 1);
        }
        case 4 : {
            inv_del(inv, gift_box, 1);
        }
    }
} else if (inv_freespace(inv) < 3) {
    ~mesbox("You don't have enough space in your inventory to open the gift box.");
    return;
}

[proc,gamble_box]

switch_int(~p_choice3_header("Match.", 1, "Straight GP.", 2, "High/Low.", 3,"How do you want to gamble?")){
    case 1 : {
        ~match_gamble;
    }
    case 2 : {
        ~straight_gamble;
    }
    case 3 : {
        ~high_low_gamble;
    }
}

[proc,match_gamble]
def_int $obj1 = random(3);
def_int $obj2 = random(3);
def_int $obj3 = random(3);
def_string $obj1n = "-empty-";
def_string $obj2n = "-empty-";
def_string $obj3n = "-empty-";

// Ask for wager amount and set a value
def_int $wager_choice = (~p_choice3_header("10,000gp", 1, "25,000gp", 2, "100,000gp", 3,"How much do you want to wager?"));
def_int $wager_amount = 0;

switch_int($wager_choice){
    case 1 : $wager_amount = 10000;
    case 2 : $wager_amount = 25000;
    case 3 : $wager_amount = 100000;
}

// Check if player has enough coins
if (inv_total(inv, coins) < $wager_amount){
    ~mesbox("You don't have enough coins to place a bet.");
    return;
} else {
    inv_del(inv, coins, $wager_amount);
}

// Generate fruit names
switch_int($obj1){
    case 1 : $obj1n = oc_name(lime);
    case 2 : $obj1n = oc_name(grapes);
    case 3 : $obj1n = oc_name(pineapple);
}
switch_int($obj2){
    case 1 : $obj2n = oc_name(lime);
    case 2 : $obj2n = oc_name(grapes);
    case 3 : $obj2n = oc_name(pineapple);
}
switch_int($obj3){
    case 1 : $obj3n = oc_name(lime);
    case 2 : $obj3n = oc_name(grapes);
    case 3 : $obj3n = oc_name(pineapple);
}
sound_synth(dice_shake, 1, 0);
~mesbox("[##]#########[##]#########[##]#########[##]");
p_delay(3);
sound_synth(dice_roll, 1, 0);
// Show the result
~mesbox("[##] <$obj1n> [##] <$obj2n> [##] <$obj3n> [##]");

// Calculate result
if ($obj1 = $obj2 & $obj2 = $obj3) {
    def_int $jackpot = multiply($wager_amount, 5);
    ~mesbox("JACKPOT! You win <tostring($jackpot)> coins!");
    inv_add(inv, coins, $jackpot);
} else {
    ~mesbox("You lost your wager of <tostring($wager_amount)> coins.");
}



[proc,straight_gamble]
return;
[proc,high_low_gamble]
return;


[proc,hc_box]
if (inv_freespace(inv) > 6){
    inv_add(inv, hc_iron_scimitar, 1);
    inv_add(inv, hc_iron_full_helm, 1);
    inv_add(inv, hc_iron_platebody, 1);
    inv_add(inv, hc_iron_platelegs, 1);
    inv_add(inv, hc_iron_kiteshield, 1);
} else if (inv_freespace(inv) < 7) {
    ~mesbox("You don't have enough space in your inventory to open the gift box.");
    return;
}
inv_del(inv, hc_box, 1);


[proc,alchemy_box]
%high_alch_gp = null;
%high_alch_gp = 1;

mes("High Alch GP Reset");
inv_del(inv,alchemy_box, 1);



[proc,rolltester]
def_int $r2 = random(10000);
def_int $var = calc($r2 - (map_clock));
mes("Var: <tostring($var)>");
switch_int($var){
    case 255 : 
        mes("Successful Proc! 255");
    case 325 :
        mes("Succesful Proc!! 325");
}



// Source: https://www.youtube.com/watch?v=JrsT--Rr0Kk&t=94s
[opheld1,event_scroll]
%book_page = 0;
%open_book = event_scroll;
@open_event_scroll;

[label,open_event_scroll]
@book_flip_page(0, 0, 3, event_scroll);

[proc,event_scroll]
def_string $christmas;
def_string $newyears;
def_string $easter;
def_string $stpat;
def_string $fourtwenty;
def_string $halloween;

def_int $christmasi = %christmas;
def_int $newyearsi = %newyearseve;
def_int $easteri = %easter;
def_int $stpati = %stpatricksday;
def_int $fourtwentyi = %420day;
def_int $halloweeni = %halloween;

switch_int($christmasi){
    case 0 : {
        $christmas = "@red@No@bla@";
    }
    case 1 : {
        $christmas = "@gre@Yes@bla@";
    }
}
switch_int($newyearsi){
    case 0 : {
        $newyears = "@red@No@bla@";
    }
    case 1 : {
        $newyears = "@gre@Yes@bla@";
    }

}
switch_int($easteri){
    case 0 : {
        $easter = "@red@No@bla@";
    }
    case 1 : {
        $easter = "@gre@Yes@bla@";
    }

}
switch_int($stpati){
    case 0 : {
        $stpat = "@red@No@bla@";
    }
    case 1 : {
        $stpat = "@gre@Yes@bla@";
    }

}
switch_int($fourtwentyi){
    case 0 : {
        $fourtwenty = "@red@No@bla@";
    }
    case 1 : {
        $fourtwenty = "@gre@Yes@bla@";
    }

}
switch_int($halloweeni){
    case 0 : {
        $halloween = "@red@No@bla@";
    }
    case 1 : {
        $halloween = "@gre@Yes@bla@";
    }

}
switch_int (%book_page) {
    case 0 : ~book("Event List", "Christmas: [<$christmas>] |New Years Eve: [<$newyears>] |Easter: [<$easter>] |St. Patricks Day: [<$stpat>] |4/20: [<$fourtwenty>] |Halloween: [<$halloween>] |||");
}