        def_int $total = inv_total(inv, 4dose2rangerspotion);
        inv_del(inv, 4dose2rangerspotion, $total);
        inv_add(chemical_tables, 4dose2rangerspotion, $total);
        anim(human_pickuptable, 0);
    }
}

[proc,imbuemenu]
def_int $choice2 = (~p_choice5_header("Prayer.", 1,"Attack.", 2,"Strength.", 3, "Defence.", 4,"Ranged.", 5,"Which potion would you like to imbue?"));
switch_int($choice2){
    case 1 : ~imbued_potions(4doseprayerrestore, 4dose2prayerrestore, 100, 15, 450);
    case 2 : ~imbued_potions(4dose2attack, 4dose3attack, 100, 15, 450);
    case 3 : ~imbued_potions(4dose2strength, 4dose3strength, 100, 15, 450);
    case 4 : ~imbued_potions(4dose2defense, 4dose3defense, 100, 15, 450);
    case 5 : ~imbued_potions(4doserangerspotion, 4dose2rangerspotion, 100, 15, 450);
}




[proc,imbued_potions](obj $first, namedobj $second, int $imbuedcost, int $cosmic_cost, int $exp)
def_int $id = inv_total(inv,imbued_dust);
def_int $cr = inv_total(inv,cosmicrune);
if($id < $imbuedcost | $cr < $cosmic_cost){
    mes("You need <tostring($imbuedcost)> imbued dust and <tostring($cosmic_cost)> cosmic runes to imbue this potion.");
    return;
}
def_int $total = inv_total(inv,$first);
switch_obj($first){
    case 4doseprayerrestore : {
        ~brewing_action($imbuedcost, $cosmic_cost);
        inv_del(inv, $first, 1);
        inv_add(inv, $second, 1);
        ~imbuing_exp($exp);
    }
    case 4dose2attack : {
        ~brewing_action($imbuedcost, $cosmic_cost);
        inv_del(inv, $first, 1);
        inv_add(inv, $second, 1);
        ~imbuing_exp($exp);
    }
    case 4dose2strength : {
        ~brewing_action($imbuedcost, $cosmic_cost);
        inv_del(inv, $first, 1);
        inv_add(inv, $second, 1);
        ~imbuing_exp($exp);
    }
    case 4dose2defense : {
        ~brewing_action($imbuedcost, $cosmic_cost);
        inv_del(inv, $first, 1);
        inv_add(inv, $second, 1);
        ~imbuing_exp($exp);
    }
    case 4doserangerspotion : {
        ~brewing_action($imbuedcost, $cosmic_cost);
        inv_del(inv, $first, 1);
        inv_add(inv, $second, 1);
        ~imbuing_exp($exp);
    }
}

[proc,imbuing_exp](int $exp)
stat_advance(herblore, $exp);
stat_advance(magic, $exp);

[proc,brewing_action](int $dust_cost, int $cosmic_cost)
def_int $random1 = random(3);
def_int $random2 = random(3);
inv_del(inv, imbued_dust, $dust_cost);
inv_del(inv, cosmicrune, $cosmic_cost);
p_delay(1);
switch_int($random1){
    case 1 : sound_synth(triffid_appear, 1, 0);
    case 2 : sound_synth(grind, 1, 0);
    case 3 : sound_synth(pop1, 1, 0);
}
anim(human_casthighlvlalchemy,0);
spotanim_pl(highlvlalchemy_casting, 92, 0);
p_delay(1);
sound_synth(high_alchemy, 1,0);
p_delay(1);
sound_synth(low_alchemy, 1,0);