// Chemistry Tables in the Mage Guild
[oploc3,loc_618] ~imbuemenu;
[oploc3,loc_619] ~imbuemenu;
// Category Wide Proc
[oplocu,_chem_table] @chem_table_use(last_useitem);

[label,chem_table_use](obj $obj)
switch_obj($obj){
    case vial_water : {
        def_int $total = inv_total(inv, vial_water);
        inv_del(inv, vial_water, $total);
        inv_add(chemical_tables, vial_water, $total);
        anim(human_pickuptable, 0);   
    }
