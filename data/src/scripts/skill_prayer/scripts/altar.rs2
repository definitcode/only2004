[oploc1,_prayer_altar] @pray_at_altar(stat_base(prayer));
//[oplocu,_prayer_altar] @bury_bones_altar(last_useitem);
[oplocu,loc_411] @bury_bones_altar(last_useitem);
[oploc2,loc_411] ~summon_zamorakwizard(loc_coord);


[proc,summon_zamorakwizard](coord $loc)
def_int $skulls = inv_total(inv, player_skull);
if ($skulls > 0) {
    inv_del(inv, player_skull, 1);
    npc_add(coord, macro_event_shade1, 600);    
} else if ($skulls > 1) {
    inv_del(inv, player_skull, 2);
    npc_add(coord, macro_event_shade2, 600);    
} else if ($skulls > 2) {
    inv_del(inv, player_skull, 3);
    npc_add(coord, macro_event_shade3, 600);    
} else if ($skulls > 3) {
    inv_del(inv, player_skull, 4);
    npc_add(coord, macro_event_shade4, 600);    
} else if ($skulls > 4) {
    inv_del(inv, player_skull, 5);
    npc_add(coord, macro_event_shade5, 600);    
} else if ($skulls > 5) {
    inv_del(inv, player_skull, 6);
    npc_add(coord, macro_event_shade6, 600);    
}


[label,bury_bones_altar](obj $item)
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}

def_int $bone_exp = oc_param($item, bone_exp);
inv_del(inv, $item, 1);
stat_advance(prayer, multiply($bone_exp, 2));

if (inv_total(worn, amulet_of_ghostspeak) > 0) {
    stat_advance(prayer, multiply($bone_exp, 2));
    mes("Your prayer skills are showing!");
}

if($item = "ashes"){
    mes("You scatter the ashes.");
    anim(human_pickuptable, 0);
    p_delay(3);
    sound_synth(bones_down, 1, 0);
} else if ($item = bones | $item = big_bones | $item = dragon_bones | $item = player_skull) {
    mes("You prepare the bones for ritual");
    anim(human_herbing_grind, 0);
    mes("You start to grind the bones.");
    p_delay(3);
    anim(human_pickuptable, 0);
    sound_synth(bones_down, 1, 0);
    
}

if ($item = bones){
    %normal_bones = calc(%normal_bones + 1);
} else if ($item = big_bones){
    %big_bones = calc(%big_bones + 1);
} else if ($item = dragon_bones){
    %dragon_bones = calc(%dragon_bones + 1);
} else if ($item = ashes){
    %ashes = calc(%ashes + 1);
}
p_stopaction;
// bones used to delay: https://www.youtube.com/watch?v=LSpyUVXa4LE&t=84s
p_delay(0);

[label,pray_at_altar](int $amount)
// p in "Prayer" is uppercase in osrs. but old videos such as: https://youtu.be/Rif_5-90nkI?t=210
// are lower case
if (stat(prayer) >= $amount) {
    mes("You already have full prayer points.");
    return;
}
// prayer boost
if (stat(prayer) >= stat_base(prayer)) {
    mes("You boost your prayer points.");
    sound_synth(prayer_boost, 0, 0);
} else {
    mes("You recharge your prayer points.");
    sound_synth(prayer_recharge, 0, 0);
}
anim(human_pray, 0);
stat_add(prayer, calc($amount - stat(prayer)), 0);

[debugproc,1pray]
stat_sub(prayer, calc(stat_base(prayer) - 1), 0);