[oploc1,_tree] @attempt_cut_tree;
// "hidden" op
[oploc3,_tree] @cut_tree;

// click use axe on tree
[oplocu,_tree]
switch_obj(last_useitem) {
    case bronze_axe, iron_axe, steel_axe, black_axe, mithril_axe, adamant_axe, rune_axe, dragon_axe, founders_axe :
        p_oploc(1); // gets delayed by a tick >:(
    // case raw_herring, herring :
    //     mes("This is not the mightiest tree in the forest.");
    //     return;
    case default : ~displaymessage(^dm_default);
};


[label,attempt_cut_tree]
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
~clearallq;
// find tree in db
db_find(woodcutting_trees:tree, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}
// check if f2p. Not sure if this is a thing. just to be safe i guess
def_namedobj $product = db_getfield($data, woodcutting_trees:product, 0);
if (oc_members($product) = true) {
    if (map_members = false) {
        mes(^mes_members_feature);
        return;
    }
}
// check level first
def_int $level = db_getfield($data, woodcutting_trees:levelrequired, 0);
if (stat(woodcutting) < $level) {
    anim(null, 0);
    mes("You need a Woodcutting level of <tostring($level)> to chop down this tree.");
    return;
}
// check inv space 2nd
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    // osrs specifies the log name, but old videos do not.
    // https://youtu.be/str4rRd9mt8?t=152
    mes("Your inventory is too full to hold any more logs.");
    return;
}

if (%action_delay < map_clock) {
    if ($level > 0 & ~woodcutting_axe_checker(true) = null) {
        return;
    }
    %action_delay = calc(map_clock + 3);
    p_oploc(1);
    return;
}
// for level 1 trees, axe message is here after the skill clock is set. But only on first interaction
def_obj $axe = ~woodcutting_axe_checker(true);
if ($axe = null) {
    return;
}

// https://youtu.be/T3IRz4hZcjc?si=4jBFvTwMwqPXuAxf&t=63
// sound on first chop
if (%founders_transmog = ^transmog_on) {
    anim(human_woodcutting_founders_axe, 0);
} else {
    anim(struct_param(oc_param($axe, woodcutting_struct), skill_anim), 0);
}
sound_synth(woodchop, 0, 0);
mes("You swing your axe at the tree.");
if (%action_delay = map_clock) {
    @get_logs($data, $axe);
}

p_oploc(3);


[label,cut_tree]
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
def_obj $axe = ~woodcutting_axe_checker(true);
if ($axe = null) {
    return;
}
// find tree in db
db_find(woodcutting_trees:tree, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}
// i think it checks level here? thats the case with fishing at least
def_int $level = db_getfield($data, woodcutting_trees:levelrequired, 0);
if (stat(woodcutting) < $level) {
    anim(null, 0);
    mes("You need a Woodcutting level of <tostring($level)> to chop down this tree.");
    return;
}
// check inv space
if (inv_freespace(inv) < 1) {
    anim(null, 0);
    // https://youtu.be/str4rRd9mt8?t=152
    mes("Your inventory is too full to hold any more logs.");
    return;
}

if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 3);
} else if (%action_delay = map_clock) {
    if (%founders_transmog = ^transmog_on) {
        anim(human_woodcutting_founders_axe, 0);
    } else {
        anim(struct_param(oc_param($axe, woodcutting_struct), skill_anim), 0);
    }
    
    @get_logs($data, $axe);
}

p_oploc(3);

[label,get_logs](dbrow $data, obj $axe)
// get lows and highs
def_int $tree_chance_low;
def_int $tree_chance_high;
$tree_chance_low, $tree_chance_high = ~woodcutting_successchance($data, $axe);
def_int $respawnrate = db_getfield($data, woodcutting_trees:respawnrate, 0);
def_int $deplete_chance = 8; // 1/8 chance to deplete
def_namedobj $axe_grade = null;
// if normal tree, add some variance
// scuffed way of doing it but it works
if ($respawnrate = 0) {
    $respawnrate = add(120, random(80));
    $deplete_chance = 0;
}
if (stat_random(stat(woodcutting), $tree_chance_low, $tree_chance_high) = true) {
    def_namedobj $product = db_getfield($data, woodcutting_trees:product, 0);
    def_int $productcount = 1;
    def_int $exp = db_getfield($data, woodcutting_trees:productexp, 0);
    if (loc_type = loc_1384 | loc_type = loc_1287 | loc_type = loc_1288 | loc_type = loc_1333 |
       loc_type = loc_1385 | loc_type = loc_1286 | loc_type = loc_1289 | loc_type = loc_1290 |
       loc_type = loc_1291 | loc_type = loc_1365 | loc_type = loc_1383 |
       loc_type = loc_1282 | loc_type = loc_1283) {
       if (stat_base(woodcutting) > 98 & ~wilderness_level(coord) > 29) {
          $product = cursed_logs; 
          $exp = 4089;
        }
    }
    mes("You get some <lowercase(oc_name($product))>.");
    if (inv_total(worn, cavalier_brown) > 0) {
        stat_advance(woodcutting, $exp);
        mes("Your woodcutting skills are showing!");
    }
    def_int $var_exp = null;
    switch_obj($axe){
        case dragon_axe : {
            $productcount = 4;
            $var_exp = multiply($exp, $productcount);
            stat_advance(woodcutting, $var_exp);
            if (inv_freespace(inv) < 4) {
              $productcount = inv_freespace(inv);
            }
        }
        case rune_axe : {
            $productcount = 3;
            $var_exp = multiply($exp, $productcount);
            stat_advance(woodcutting, $var_exp);
            if (inv_freespace(inv) < 3) {
              $productcount = inv_freespace(inv);
            }
        }
        case adamant_axe : {
            $var_exp = multiply($exp, 2);
            $productcount = 3;
            if (inv_freespace(inv) < 2) {
              $productcount = inv_freespace(inv);
              $var_exp = multiply($exp, $productcount);
            }
            stat_advance(woodcutting, $var_exp);
        }
        case mithril_axe : {
            $productcount = 2;
            stat_advance(woodcutting, $exp);
            if (inv_freespace(inv) < 2) {
              $productcount = inv_freespace(inv);
            }
        }
        case black_axe : {
            $productcount = 1;
            stat_advance(woodcutting, $exp);
        }
        case steel_axe : {
            $productcount = 1;
            stat_advance(woodcutting, $exp);
        }
        case founders_axe : {
            $productcount = 1;
            stat_advance(woodcutting, $exp);
        }
        case iron_axe : {
            $productcount = 1;
            stat_advance(woodcutting, $exp);
        }
        case bronze_axe : {
            $productcount = 1;
            stat_advance(woodcutting, $exp);
        }
    }
    inv_add(inv, $product, $productcount);
    switch_namedobj($product){
        case logs : {
            %logs_cut = calc(%logs_cut + $productcount);
        }
        case oak_logs : {
            %oak_logs_cut = calc(%oak_logs_cut + $productcount);
        }
        case willow_logs : {
            %willow_logs_cut = calc(%willow_logs_cut + $productcount);
        }
        case maple_logs : {
            %maple_logs_cut = calc(%maple_logs_cut + $productcount);
        }
        case yew_logs : {
            %yew_logs_cut = calc(%yew_logs_cut + $productcount);
        }
        case magic_logs : {
            %magic_logs_cut = calc(%magic_logs_cut + $productcount);
        }
        case cursed_logs : {
            %cursed_logs_cut = calc(%cursed_logs_cut + $productcount);
        }
    }
    if (random($deplete_chance) = 0) {
        $respawnrate = ~scale_by_playercount($respawnrate);
        loc_change(loc_param(next_loc_stage), $respawnrate);
        anim(null, 0);
        return;
    }
}
p_oploc(3);


[proc,woodcutting_successchance](dbrow $data, obj $axe)(int, int)
def_int $count = calc(db_getfieldcount($data, woodcutting_trees:successchance) - 1);
while ($count >= 0) {
    def_obj $db_axe;
    def_int $tree_chance_low;
    def_int $tree_chance_high;
    $db_axe, $tree_chance_low, $tree_chance_high = db_getfield($data, woodcutting_trees:successchance, $count);
    if ($db_axe = $axe) {
        return($tree_chance_low, $tree_chance_high);
    } else {
        $count = calc($count - 1);
    }
}
return(null, null);
