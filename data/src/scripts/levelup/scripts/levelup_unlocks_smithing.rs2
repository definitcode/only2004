[label,levelup_smithing]
//Smithing level up unlock messages
switch_int(stat_base(smithing)) {
    case 2 :  mes("You can now make Bronze Maces.");
    case 3 :  mes("You can now make Bronze Medium Helms.");
    case 4 :  mes("You can now make Bronze Short Swords and members can make Bronze Dart Tips and Bronze Wire.");
    case 5 :  mes("You can now make Bronze Scimitars and members can make Bronze Arrow Heads.");
    case 6 :  mes("You can now make Bronze Long Swords.");
    case 7 :  mes("You can now make Bronze Full Helms and members can make Bronze Throwing Knives.");
    case 8 :  mes("You can now make Bronze Square Shields.");
    case 9 :  mes("You can now make Bronze Warhammers.");
    case 10 : mes("You can now make Bronze Battle Axes.");
    case 11 : mes("You can now make Bronze Chainmail Bodies.");
    case 12 : mes("You can now make Bronze Kite Shields.");
    case 14 : mes("You can now make Bronze Two Handed Swords.");
    case 15 : 
        mes("You can now smelt Iron Ore and make Iron Daggers.");
        ~objbox(iron_hammer,"You can now use an @dbl@Iron Hammer.", 250, 0, 0);
    case 16 : mes("You can now make Bronze Plate Legs, Bronze Plate Skirts and Iron Axes.");
    case 17 : mes("You can now make Iron Maces.");
    case 18 : mes("You can now make Bronze Plate Bodies and Iron Medium Helms.");
    case 19 : mes("You can now make Iron Short Swords and members can make Iron Dart Tips.");
    case 20 : mes("You can now smelt Silver Ore and make Iron Scimitars and members can make Iron Arrow Heads.");
    case 21 : ~objbox(iron_longsword,"You can now make @dbl@Iron Long Swords.", 250, 0, 0);
    case 22 : ~doubleobjbox(iron_full_helm,iron_knife,"You can now make @dbl@Iron Full Helms@bla@ and members can|make @dbl@Iron Throwing Knives.", 200);
    case 23 : ~objbox(iron_sq_shield,"You can now make @dbl@Iron Square Shields.", 250, 0, 0);
    case 24 : ~objbox(iron_warhammer,"You can now make @dbl@Iron Warhammers.", 250, 0, 0);
    case 25 : ~objbox(iron_battleaxe,"You can now make @dbl@Iron Battleaxes.", 250, 0, 0);
    case 26 : ~objbox(iron_chainbody,"You can now make @dbl@Iron Chainmail Bodies.", 250, 0, 0);
    case 27 : ~objbox(iron_kiteshield,"You can now make @dbl@Iron Kite Shields.", 250, 0, 0);
    case 29 : ~objbox(iron_2h_sword,"You can now make @dbl@Iron Two Handed Swords.", 250, 0, 0);
    case 30 : 
        ~doubleobjbox(iron_ore,steel_dagger,"You can now smelt @dbl@Steel@bla@ and make @dbl@Steel Daggers.", 200);
        ~objbox(steel_hammer,"You can now use a @dbl@Steel Hammer.", 250, 0, 0);
    case 31 : ~doubleobjbox(iron_platelegs,steel_axe,"You can now make @dbl@Iron Plate Legs@bla@, @dbl@Iron Plate Skirts|@bla@and @dbl@Steel Axes.", 200);
    case 32 : ~objbox(steel_mace,"You can now make @dbl@Steel Maces.", 250, 0, divide(^objbox_height, 2));
    case 33 : ~doubleobjbox(iron_platebody,steel_med_helm," You can now make @dbl@Iron Plate Bodies and Steel||@dbl@Medium Helms. ||", 200);
    case 34 : ~doubleobjbox(steel_sword,steel_dart_tip,"You can now make @dbl@Steel Short Swords@bla@ and members|can make @dbl@Steel Dart Tips.", 200);
    case 35 : ~doubleobjbox(steel_scimitar,steel_arrowheads,"You can now make @dbl@Steel Scimitars and members can|make @dbl@Steel Arrow Heads.", 200);
    case 36 : ~doubleobjbox(steel_longsword,studs,"You can now make @dbl@Steel Long Swords@bla@. Members can|make @dbl@Steel Studs.", 200);
    case 37 : ~doubleobjbox(steel_full_helm,steel_knife,"You can now make @dbl@Steel Full Helms@bla@ and members can|make @dbl@Steel Throwing Knives.", 200);
    case 38 : ~objbox(steel_sq_shield,"You can now make @dbl@Steel Square Shields.", 250, 0, 0);
    case 39 : ~objbox(steel_warhammer,"You can now make @dbl@Steel Warhammers.", 250, 0, 0);
    case 40 : ~doubleobjbox(gold_ore,steel_battleaxe,"You can now smelt @dbl@Gold Ore@bla@ and make @dbl@Steel|@dbl@Battleaxes.", 200);
    case 41 : ~objbox(steel_chainbody,"You can now make @dbl@Steel Chainmail Bodies.", 250, 0, 0);
    case 42 : ~objbox(steel_kiteshield,"You can now make @dbl@Steel Kite Shields.", 250, 0, 0);
    case 44 : ~objbox(steel_2h_sword,"You can now make @dbl@Steel Two Handed Swords.", 250, 0, 0);
    case 46 : ~doubleobjbox(steel_platelegs,steel_plateskirt,"You can now make @dbl@Steel Plate Legs@bla@ and @dbl@Steel Plate Skirts.", 200);
    case 48 : ~objbox(steel_platebody,"You can now make @dbl@Steel Plate Bodies.", 250, 0, 0);
    case 50 : 
        ~doubleobjbox(mithril_hammer, mithril_dagger,"You can now use a @dbl@Mithril Hammer@bla@ and members |can make @dbl@Mithril Dagger.", 200);
    case 51 : ~objbox(mithril_axe,"You can now make @dbl@Mithril Axes.", 250, 0, 0);
    case 52 : ~objbox(mithril_mace,"You can now make @dbl@Mithril Maces.", 250, 0, divide(^objbox_height, 2));
