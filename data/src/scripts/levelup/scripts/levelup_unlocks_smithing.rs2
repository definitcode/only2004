        ~objbox(adamant_hammer,"You can now use an @dbl@Adamant Hammer.", 250, 0, 0);
    case 71 : ~objbox(adamant_axe,"You can now make @dbl@Adamant Axes.", 250, 0, 0);
    case 72 : ~objbox(adamant_mace,"You can now make @dbl@Adamant Maces.", 250, 0, divide(^objbox_height, 2));
    case 73 : ~objbox(adamant_med_helm,"You can now make @dbl@Adamant Medium Helms.", 250, 0, divide(^objbox_height, 2));
    case 74 : ~doubleobjbox(adamant_sword,adamant_dart_tip,"You can now make @dbl@Adamant Short Swords@bla@ and members|can make @dbl@Adamant Dart Tips.", 200);
    case 75 : ~doubleobjbox(adamant_scimitar,adamant_arrowheads,"You can now make @dbl@Adamant Scimitars@bla@ and members|can make @dbl@Adamant Arrow Heads.", 200);
    case 76 : ~objbox(adamant_longsword,"You can now make @dbl@Adamant Long Swords.", 250, 0, 0);
    case 77 : ~doubleobjbox(adamant_full_helm,adamant_knife,"You can now make @dbl@Adamant Full Helms@bla@ and members|can make @dbl@Adamant Throwing Knives.", 200);
    case 78 : ~objbox(adamant_sq_shield,"You can now make @dbl@Adamant Square Shields.", 250, 0, 0);
    case 79 : ~objbox(adamant_warhammer,"You can now make @dbl@Adamant Warhammers.", 250, 0, 0);
    case 80 : 
        ~objbox(adamant_battleaxe,"You can now make @dbl@Adamant Battleaxes.", 250, 0, 0);
        ~objbox(rune_hammer,"You can now use a @dbl@Rune Hammer.", 250, 0, 0);
    case 81 : ~objbox(adamant_chainbody,"You can now make @dbl@Adamant Chainmail Bodies.", 250, 0, 0);
    case 82 : ~objbox(adamant_kiteshield,"You can now make @dbl@Adamant Kite Shields.", 250, 0, 0);
    case 84 : ~objbox(adamant_2h_sword,"You can now make @dbl@Adamant Two Handed Swords.", 250, 0, 0);
    case 85 : ~objbox(rune_dagger,"You can now make @dbl@Rune Daggers.", 250, 0, 0);
    case 86 : ~doubleobjbox(adamant_platelegs,adamant_plateskirt,"You can now make @dbl@Adamant Plate Legs@bla@, @dbl@Adamant Plate Skirts@bla@ and @dbl@Rune Axes.", 200);
    case 87 : ~objbox(rune_mace,"You can now make @dbl@Rune Maces.", 250, 0, divide(^objbox_height, 2));
    case 88 : ~doubleobjbox(adamant_platebody,rune_med_helm," You can now make @dbl@Adamant Plate Bodies and Rune||@dbl@Medium Helms. ||", 200); 
    case 89 : ~doubleobjbox(rune_sword,rune_dart_tip,"You can now make @dbl@Rune Short Swords@bla@ and members|can make @dbl@Rune Dart Tips.", 200);
    case 90 : 
        ~objbox(dragon_hammer,"You can now use a @dbl@Dragon Hammer.", 250, 0, 0);
        ~doubleobjbox(rune_scimitar,rune_arrowheads,"You can now make @dbl@Rune Scimitars@bla@ and members|can make @dbl@Rune Arrow Heads.", 200);
    case 81 : ~objbox(rune_longsword,"You can now make @dbl@Rune Long Swords.", 250, 0, 0);
    case 82 : ~doubleobjbox(rune_full_helm,rune_knife,"You can now make @dbl@Rune Full Helms@bla@ and members|can make @dbl@Rune Throwing Knives.", 200);
    case 83 : ~objbox(rune_sq_shield,"You can now make @dbl@Rune Square Shields.", 250, 0, 0);
    case 84 : ~objbox(rune_warhammer,"You can now make @dbl@Rune Warhammers.", 250, 0, 0);
    case 85 : ~objbox(rune_battleaxe,"You can now make @dbl@Rune Battleaxes.", 250, 0, 0);
    case 86 : ~objbox(rune_chainbody,"You can now make @dbl@Rune Chainmail Bodies.", 250, 0, 0);
    case 87 : ~objbox(rune_kiteshield,"You can now make @dbl@Rune Kite Shields.", 250, 0, 0);
    case 98 : ~doubleobjbox(dragon_dagger,dragon_med_helm,"You can now make @dbl@Dragon Daggers@bla@ and @dbl@Dragon Medium Helms.", 200);
    case 99 : 
        ~doubleobjbox(dragon_platebody,dragon_full_helm,"You can now make @dbl@Dragon Plate Bodies@bla@ and @dbl@Dragon Full Helms.", 200);
        ~objbox(blacksmithing_cape,"You can now where an @dbl@Smithing Cape @bla@!", 250, 0, 0);
