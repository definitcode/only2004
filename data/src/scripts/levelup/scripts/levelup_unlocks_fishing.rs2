[label,levelup_fishing]
//Fishing level up unlock messages
switch_int(stat_base(fishing)) {
    case 5 : mes("You can now try fishing for Sardines.");
    case 10 : mes("You can now try fishing for Herring.");
    case 15 : 
        mes("You can now try to net Anchovies.");
        ~doubleobjbox(iron_harpoon,lobster_pot_oak,"You can now use @dbl@Iron Harpoon @bla@and a @dbl@Oak Lobster Pot.", 200);
    case 16 : mes("You can now try fishing for Mackerel,Oysters and Caskets with a large net.");
    case 20 : ~doubleobjbox(raw_trout,fly_fishing_rod,"You can now try fishing for @dbl@Trout.", 200);
    case 23 : ~doubleobjbox(raw_cod,net,"Members can now try fishing for @dbl@Cod with a large net.", 200);
    case 25 : ~doubleobjbox(raw_pike,fishing_rod,"You can now try fishing for @dbl@Pike.", 200);
    case 30 : 
        ~doubleobjbox(raw_salmon,fly_fishing_rod,"You can now try fishing for @dbl@Salmon.", 200);
        ~doubleobjbox(steel_harpoon,lobster_pot_willow,"You can now use @dbl@Steel Harpoon @bla@and a @dbl@Willow Lobster Pot.", 200);
    case 35 : ~doubleobjbox(raw_tuna,harpoon,"You can now try harpooning @dbl@Tuna.", 200);
    case 40 : ~doubleobjbox(raw_lobster,lobster_pot,"You can now try to catch @dbl@Lobsters.", 200);
    case 46 : ~doubleobjbox(raw_bass,big_net,"Members can now try fishing for @dbl@Sea Bass with a large net.", 200);
    case 50 : 
        ~doubleobjbox(raw_swordfish,harpoon,"You can now try harpooning @dbl@Swordfish.", 200);
        ~doubleobjbox(mithril_harpoon,lobster_pot_maple,"You can now use @dbl@Mithril Harpoon @bla@and a @dbl@Maple Lobster Pot.", 200);
    case 53 : ~doubleobjbox(raw_lava_eel,fishing_rod,"Members can now try catching @dbl@Lava Eels.", 200);
    case 68 : ~mesbox("Members are now qualified to enter the @dbl@Fishing Guild.");
    case 70 : ~doubleobjbox(adamant_harpoon,lobster_pot_yew,"You can now use @dbl@Adamant Harpoon @bla@and a @dbl@Yew Lobster Pot.", 200);
    case 76 : ~doubleobjbox(raw_shark,harpoon,"Members can now try harpooning @dbl@Sharks.", 200); //imgur.com/SvV4b4p
    case 79 : ~doubleobjbox(raw_seaturtle,bucket_empty,"Members can now catch @dbl@Sea Turtles on the Trawler.|", 200); //imgur.com/T0raUc4
    case 80 : ~doubleobjbox(rune_harpoon,lobster_pot_magic,"You can now use @dbl@Rune Harpoon @bla@and a @dbl@Magic Lobster Pot.", 200);
    case 81 : ~doubleobjbox(raw_mantaray,bucket_empty,"Members can now catch @dbl@Manta Rays on the Trawler.|", 200); //imgur.com/DVv0WDM
    case 90 : ~doubleobjbox(dragon_harpoon,lobster_pot_willow,"You can now use @dbl@Dragon Harpoon @bla@and a @dbl@Dragon Lobster Pot.", 200);
    case 99 : ~objbox(fishing_cape,"You can now wear a @dbl@Fishing Cape", 200, 0, 0);
}
