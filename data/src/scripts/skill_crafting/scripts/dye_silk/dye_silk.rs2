[opheldu,silk] @dye_silk(last_useitem);


[label,dye_silk](obj $obj)
switch_obj($obj){
    case blackdye : {
        if (stat_base(crafting) < 30){
            mes("You need 30 Crafting to do this.");
            return;
        }
        inv_del(inv, silk, 1);
        inv_del(inv, blackdye, 1);
        inv_add(inv, black_silk, 1);
        p_delay(1);
        return;
    }
    case bluedye : {
        inv_del(inv, silk, 1);
        inv_del(inv, bluedye, 1);
        inv_add(inv, blue_silk, 1);
        p_delay(1);
        return;
    }
    case reddye : {
        if (stat_base(crafting) < 90){
            mes("You need 90 Crafting to do this.");
            return;
        }
        inv_del(inv, silk, 1);
        inv_del(inv, reddye, 1);
        inv_add(inv, crimson_silk, 1);
        p_delay(1);
        return;       
    }
}