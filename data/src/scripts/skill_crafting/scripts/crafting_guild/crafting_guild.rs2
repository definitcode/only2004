[oploc1,crafting_guild_door]
if (~check_axis(coord, loc_coord, loc_angle) = true) {
    if (stat(crafting) < 60) {
        ~chatnpc_specific(nc_name(master_crafter), master_crafter, "<p,neutral>Sorry only experienced craftsmen are allowed in here.|You must be level 60 or above to enter.");
        return;
    }
    if (inv_total(worn, brown_apron) < 1) {
        ~chatnpc_specific(nc_name(master_crafter), master_crafter, "<p,neutral>Where's your brown apron? You can't come in here unless you're wearing one.");
        if (inv_total(inv, brown_apron) < 1) {
            ~chatplayer("<p,neutral>Err... I haven't got one.");
        }
        return;
    }
    ~open_and_close_door(loc_param(next_loc_stage), true, false);
    ~chatnpc_specific(nc_name(master_crafter), master_crafter, "<p,neutral>Welcome to the Guild of Master Craftsmen.");
} else {
    ~open_and_close_door(loc_param(next_loc_stage), false, false);
}

[opnpc1,master_crafter]
~openshop_activenpc;

[opnpc2,master_crafter]
~convert_pottery;

[proc,convert_pottery]
def_int $fb = inv_total(inv, bowl_empty);
def_int $pd = inv_total(inv, piedish);
def_int $pot = inv_total(inv, pot_empty);
if ($fb > 0){
    inv_del(inv, bowl_empty, $fb);
    inv_add(inv, cert_bowl_empty, $fb);
    ~chatnpc("<p,happy>I have swapped your items for notes you can redeem at the bank!");
} else if ($pd > 0){
    inv_del(inv, piedish, $pd);
    inv_add(inv, cert_piedish, $pd);
    ~chatnpc("<p,happy>I have swapped your items for notes you can redeem at the bank!");
} else if ($pot > 0){
    inv_del(inv, pot_empty, $pot);
    inv_add(inv, cert_pot_empty, $pot);
    ~chatnpc("<p,happy>I have swapped your items for notes you can redeem at the bank!");
} else {
    mes("You don't have anything to convert");
    return;
}

