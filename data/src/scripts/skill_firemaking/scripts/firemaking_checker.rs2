[proc,firemaking_checker]()(obj)
def_int $lvl0 = stat(firemaking);
def_obj $obj1 = null;
if (inv_total(worn, dragon_tinderbox) > 0) {
    $obj1 = dragon_tinderbox;
} else if (inv_total(worn, rune_tinderbox) > 0) {
    $obj1 = rune_tinderbox;
} else if (inv_total(worn, adamant_tinderbox) > 0) {
    $obj1 = adamant_tinderbox;
} else if (inv_total(worn, mithril_tinderbox) > 0) {
    $obj1 = mithril_tinderbox;
} else if (inv_total(worn, steel_tinderbox) > 0) {
    $obj1 = steel_tinderbox;
} else if (inv_total(worn, iron_tinderbox) > 0) {
    $obj1 = iron_tinderbox;
} else if (inv_total(worn, bronze_tinderbox) > 0) {
    $obj1 = bronze_tinderbox;
} else if (inv_total(worn, founders_tinderbox) > 0) {
    $obj1 = founders_tinderbox;
} else if (inv_total(worn, hc_tinderbox) > 0) {
    $obj1 = hc_tinderbox;
} else if (inv_total(worn, tinderbox) > 0) {
    $obj1 = tinderbox;
}
if ($lvl0 >= oc_param(dragon_tinderbox, levelrequire) & ($obj1 = dragon_tinderbox)) {
    return(dragon_tinderbox);
}
if ($lvl0 >= oc_param(rune_tinderbox, levelrequire) & ($obj1 = rune_tinderbox)) {
    return(rune_tinderbox);
}
if ($lvl0 >= oc_param(adamant_tinderbox, levelrequire) & ($obj1 = adamant_tinderbox)) {
    return(adamant_tinderbox);
}
if ($lvl0 >= oc_param(mithril_tinderbox, levelrequire) & ($obj1 = mithril_tinderbox)) {
    return(mithril_tinderbox);
}
if ($lvl0 >= oc_param(steel_tinderbox, levelrequire) & ($obj1 = steel_tinderbox)) {
    return(steel_tinderbox);
}
if ($lvl0 >= oc_param(iron_tinderbox, levelrequire) & ($obj1 = iron_tinderbox)) {
    return(iron_tinderbox);
}
if ($lvl0 >= oc_param(bronze_tinderbox, levelrequire) & ($obj1 = bronze_tinderbox)) {
    return(bronze_tinderbox);
}
if ($lvl0 >= oc_param(founders_tinderbox, levelrequire) & ($obj1 = founders_tinderbox)) {
    return(founders_tinderbox);
}
if ($lvl0 >= oc_param(hc_tinderbox, levelrequire) & ($obj1 = hc_tinderbox)) {
    return(hc_tinderbox);
}
if ($lvl0 >= oc_param(tinderbox, levelrequire) & ($obj1 = tinderbox)) {
    return(tinderbox);
}
return(null);