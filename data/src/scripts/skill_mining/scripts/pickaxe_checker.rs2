[proc,pickaxe_checker]()(obj)
def_int $lvl0 = stat(mining);
def_obj $obj1 = inv_getobj(worn, ^wearpos_rhand);
if ($lvl0 >= oc_param(dragon_pickaxe, levelrequire) & ($obj1 = dragon_pickaxe)) {
    return(dragon_pickaxe);
}
if ($lvl0 >= oc_param(rune_pickaxe, levelrequire) & ($obj1 = rune_pickaxe)) {
    return(rune_pickaxe);
}
if ($lvl0 >= oc_param(adamant_pickaxe, levelrequire) & ($obj1 = adamant_pickaxe)) {
    return(adamant_pickaxe);
}
if ($lvl0 >= oc_param(mithril_pickaxe, levelrequire) & ($obj1 = mithril_pickaxe)) {
    return(mithril_pickaxe);
}
if ($lvl0 >= oc_param(steel_pickaxe, levelrequire) & ($obj1 = steel_pickaxe)) {
    return(steel_pickaxe);
}
if ($lvl0 >= oc_param(iron_pickaxe, levelrequire) & ($obj1 = iron_pickaxe)) {
    return(iron_pickaxe);
}
if ($lvl0 >= oc_param(bronze_pickaxe, levelrequire) & ($obj1 = bronze_pickaxe)) {
    return(bronze_pickaxe);
}
if ($lvl0 >= oc_param(founders_pickaxe, levelrequire) & ($obj1 = founders_pickaxe)) {
    return(founders_pickaxe);
}
return(null);
