[proc,hammer_checker]()(obj)
def_int $lvl0 = stat(smithing);
def_obj $obj1 = null;
if (inv_total(inv, dragon_hammer) > 0) {
    $obj1 = dragon_hammer;
} else if (inv_total(inv, rune_hammer) > 0) {
    $obj1 = rune_hammer;
} else if (inv_total(inv, adamant_hammer) > 0) {
    $obj1 = adamant_hammer;
} else if (inv_total(inv, mithril_hammer) > 0) {
    $obj1 = mithril_hammer;
} else if (inv_total(inv, steel_hammer) > 0) {
    $obj1 = steel_hammer;
} else if (inv_total(inv, iron_hammer) > 0) {
    $obj1 = iron_hammer;
} else if (inv_total(inv, bronze_hammer) > 0) {
    $obj1 = bronze_hammer;
} else if (inv_total(inv, hammer) > 0) {
    $obj1 = hammer;
}
if ($lvl0 >= oc_param(dragon_hammer, levelrequire) & ($obj1 = dragon_hammer)) {
    return(dragon_hammer);
}
if ($lvl0 >= oc_param(rune_hammer, levelrequire) & ($obj1 = rune_hammer)) {
    return(rune_hammer);
}
if ($lvl0 >= oc_param(adamant_hammer, levelrequire) & ($obj1 = adamant_hammer)) {
    return(adamant_hammer);
}
if ($lvl0 >= oc_param(mithril_hammer, levelrequire) & ($obj1 = mithril_hammer)) {
    return(mithril_hammer);
}
if ($lvl0 >= oc_param(steel_hammer, levelrequire) & ($obj1 = steel_hammer)) {
    return(steel_hammer);
}
if ($lvl0 >= oc_param(iron_hammer, levelrequire) & ($obj1 = iron_hammer)) {
    return(iron_hammer);
}
if ($lvl0 >= oc_param(bronze_hammer, levelrequire) & ($obj1 = bronze_hammer)) {
    return(bronze_hammer);
}
if ($lvl0 >= oc_param(bronze_hammer, levelrequire) & ($obj1 = bronze_hammer)) {
    return(hammer);
}
return(null);