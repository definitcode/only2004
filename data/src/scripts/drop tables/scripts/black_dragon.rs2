[ai_queue3,black_dragon]
if (npc_findhero = false) {
    return;
}
if (npc_findhero = true) {
    queue(black_dragon_kill, 0);
}
gosub(npc_death);
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
//obj_add(npc_coord, dragonhide_black, 1, ^lootdrop_duration);
if (%hunter = 396) {
    if (%e_ctoggle = ^e_toggle_on) {
        mes("[4x] Resources!");
    }
} else if (%hunter > 349) {
    if (%e_ctoggle = ^e_toggle_on) {
        mes("[2x] Resources!");
    }
}
// Tertiary
~trail_hardcluedrop(128, npc_coord);
def_obj $knife = ~skinning_checker;
def_namedobj $scale = black_dragon_scale;
def_int $drop_multiplier = 1;
if (distance(coord, npc_coord) < 3){
    switch_obj($knife){
        case e_dragon_knife : {
            $drop_multiplier = 5;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }     
        }
        case e_rune_knife : {
            $drop_multiplier = 4;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            } 
        }
        case e_adamant_knife : {
            $drop_multiplier = 3;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_mithril_knife : {
            $drop_multiplier = 2;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }  
        }
        case e_steel_knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case hc_knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }
        case founders_knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }
        case e_bronze_knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_black, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case null : mes("You don't have a knife to skin this monster.");
    }
} else {
    mes("You were not close enough to attempt skinning the monster.");
}
def_int $random = random(128);

if ($random < 4) {
    obj_add(npc_coord, mithril_2h_sword, 1, ^lootdrop_duration);
} else if ($random < 7) {
    obj_add(npc_coord, mithril_axe, 1, ^lootdrop_duration);
} else if ($random < 10) {
    obj_add(npc_coord, mithril_battleaxe, 1, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, rune_knife, 2, ^lootdrop_duration);
} else if ($random < 14) {
    obj_add(npc_coord, mithril_kiteshield, 1, ^lootdrop_duration);
} else if ($random < 15) {
    obj_add(npc_coord, adamant_platebody, 1, ^lootdrop_duration);
} else if ($random < 16) {
    obj_add(npc_coord, rune_longsword, 1, ^lootdrop_duration);
} else if ($random < 36) {
    obj_add(npc_coord, adamant_javelin, 30, ^lootdrop_duration);
} else if ($random < 44) {
    obj_add(npc_coord, firerune, 80, ^lootdrop_duration);
} else if ($random < 51) {
    obj_add(npc_coord, adamant_dart_p, 16, ^lootdrop_duration);
} else if ($random < 56) {
    obj_add(npc_coord, lawrune, 25, ^lootdrop_duration);
} else if ($random < 59) {
    obj_add(npc_coord, bloodrune, 15, ^lootdrop_duration);
} else if ($random < 60) {
    obj_add(npc_coord, airrune, 200, ^lootdrop_duration);
    obj_add(npc_coord, mindrune, 200, ^lootdrop_duration);
} else if ($random < 100) {
    obj_add(npc_coord, coins, 196, ^lootdrop_duration);
} else if ($random < 110) {
    obj_add(npc_coord, coins, 330, ^lootdrop_duration);
} else if ($random < 111) {
    obj_add(npc_coord, coins, 690, ^lootdrop_duration);
} else if ($random < 114) {
    obj_add(npc_coord, adamantite_bar, 1, ^lootdrop_duration);
} else if ($random < 117) {
    obj_add(npc_coord, chocolate_cake, 1, ^lootdrop_duration);
} else if ($random < 120) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
    obj_add(npc_coord, ~grindingtable, ^lootdrop_duration);
} else if ($random < 122) {
    obj_add(npc_coord, ~ultrarare_getitem, ^lootdrop_duration);
} else if ($random < 121) {
    obj_add(npc_coord, macro_genilamp, 1, ^lootdrop_duration);
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
    obj_add(npc_coord, ~grindingtable, ^lootdrop_duration);
} else if ($random < 125) {
    obj_add(npc_coord, ~high_tier_items, ^lootdrop_duration);
}

[queue,black_dragon_kill]
if (~wilderness_level(coord) > 0){
    obj_add(coord, ~wilderness_table, ^lootdrop_duration);
}
if (%active_slayer_task = ^black_dragon){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}
if (%e_ctoggle = ^e_toggle_on){
    mes("You etch another tally into your ledger.");
}
%black_dragon_kc = calc(%black_dragon_kc + 1);