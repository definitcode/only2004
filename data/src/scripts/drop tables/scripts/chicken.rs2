// https://oldschool.runescape.wiki/w/Chicken#Drops
[ai_queue3,_chicken]
if (npc_findhero = false) {
    return;
}
if(npc_findhero = true) { // happens before npc_death
    queue(chicken_kill, 0);
}
gosub(npc_death);

// todo confirm duration



// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);

// Tertiary
gosub(trail_checkmediumdrop);

// Normal drop
//obj_add(npc_coord, raw_chicken, 1, ^lootdrop_duration);
// Other
def_int $chicken_multi = 1;
def_int $feather_multi = 1;
if (%hunter > 349) {
   $chicken_multi = 4;
   $feather_multi = 15;
    if (%e_ctoggle = ^e_toggle_on) {
        mes("-----");
        mes("[4x] Resources!");
    }
} else if (%hunter > 189) {
   $chicken_multi = 2;
   $feather_multi = 10;
    if (%e_ctoggle = ^e_toggle_on) {
        mes("-----");
        mes("[2x] Resources!");
    }
} else {
   $chicken_multi = 1;
   $feather_multi = 5;
}

def_obj $knife = ~skinning_checker;
switch_obj($knife){
    case e_dragon_knife : {
        obj_add(npc_coord, raw_chicken, calc($chicken_multi + 5), ^lootdrop_duration);
        obj_add(npc_coord, feather, calc($feather_multi + 5), ^lootdrop_duration);
    }
    case e_rune_knife : {
        obj_add(npc_coord, raw_chicken, calc($chicken_multi + 4), ^lootdrop_duration);
        obj_add(npc_coord, feather, calc($feather_multi + 4), ^lootdrop_duration);
    }
    case e_adamant_knife : {
        obj_add(npc_coord, raw_chicken, calc($chicken_multi + 3), ^lootdrop_duration);
        obj_add(npc_coord, feather, calc($feather_multi + 3), ^lootdrop_duration);
    }
    case e_mithril_knife : {
        obj_add(npc_coord, raw_chicken, calc($chicken_multi + 2), ^lootdrop_duration);
        obj_add(npc_coord, feather, calc($feather_multi + 2), ^lootdrop_duration);
    }
    case e_steel_knife : {
        obj_add(npc_coord, raw_chicken, $chicken_multi, ^lootdrop_duration);
        obj_add(npc_coord, feather, $feather_multi, ^lootdrop_duration);
    }
    case e_bronze_knife : {
        obj_add(npc_coord, raw_chicken, $chicken_multi, ^lootdrop_duration);
        obj_add(npc_coord, feather, $feather_multi, ^lootdrop_duration);
    }
    case knife : {
        obj_add(npc_coord, raw_chicken, $chicken_multi, ^lootdrop_duration);
        obj_add(npc_coord, feather, $feather_multi, ^lootdrop_duration);   
    }
    case founders_knife : {
        obj_add(npc_coord, raw_chicken, $chicken_multi, ^lootdrop_duration);
        obj_add(npc_coord, feather, $feather_multi, ^lootdrop_duration);
    }
    case hc_knife : {
        obj_add(npc_coord, raw_chicken, $chicken_multi, ^lootdrop_duration);
        obj_add(npc_coord, feather, $feather_multi, ^lootdrop_duration);
    }
    
}

[queue,chicken_kill]
if (%e_ctoggle = ^e_toggle_on){
    mes("You etch another tally into your ledger.");
}
%chicken_kc = calc(%chicken_kc + 1);