[ai_queue3,hellhound]
if (npc_findhero = false) {
    return;
}
if (npc_findhero = true) {
    queue(hellhound_kill, 0);
}
gosub(npc_death);
def_int $random = random(128);
//def_int $number = 1;
//%bt_hellhound_kc = add(%bt_hellhound_kc, $number);
// Tertiary
~trail_easycluedrop(128, npc_coord);
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
//obj_add(npc_coord, dragonhide_green, 1, ^lootdrop_duration);
if (%hunter > 396) {
    if (%e_ctoggle = ^e_toggle_on) {
        mes("[4x] Resources!");
    }
} else if (%hunter > 349) {
    if (%e_ctoggle = ^e_toggle_on) {
        mes("[2x] Resources!");
    }
}
// Tertiary
~trail_hardcluedrop(128, npc_coord);
def_obj $knife = ~skinning_checker;
def_int $drop_multiplier = 1;
if (distance(coord, npc_coord) < 3){
    switch_obj($knife){
        case e_dragon_knife : {
            $drop_multiplier = 5;
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_rune_knife : {
            $drop_multiplier = 4;
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_adamant_knife : {
            $drop_multiplier = 3;
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord,  hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_mithril_knife : {
            $drop_multiplier = 2;
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_steel_knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_bronze_knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case hc_knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }
        case founders_knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }
        case knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, hound_hide, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }

        case null : mes("You don't have a knife to skin this monster.");
    }
    mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
} else {
    mes("You were not close enough to attempt skinning the monster.");
}
if ($random < 5) {
    obj_add(npc_coord, iron_2h_sword, 1, ^lootdrop_duration);
} else if ($random < 9) {
    obj_add(npc_coord, black_kiteshield, 1, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, steel_axe, 1, ^lootdrop_duration);
} else if ($random < 17) {
    obj_add(npc_coord, steel_sword, 1, ^lootdrop_duration);
} else if ($random < 18) {
    obj_add(npc_coord, iron_platelegs, 1, ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, mithril_mace, 1, ^lootdrop_duration);
} else if ($random < 20) {
    obj_add(npc_coord, mithril_sq_shield, 1, ^lootdrop_duration);
} else if ($random < 24) { // 4/128
    obj_add(npc_coord, naturerune, 6, ^lootdrop_duration);
} else if ($random < 27) { // 3/128
    obj_add(npc_coord, mindrune, 24, ^lootdrop_duration);
} else if ($random < 30) { // 3/128
    obj_add(npc_coord, bodyrune, 37, ^lootdrop_duration);
} else if ($random < 32) { // 2/128
    obj_add(npc_coord, lawrune, 3, ^lootdrop_duration);
} else if ($random < 33) { // 1/128
    obj_add(npc_coord, waterrune, 12, ^lootdrop_duration);
} else if ($random < 34) { // 1/128
    obj_add(npc_coord, cosmicrune, 4, ^lootdrop_duration);
} else if ($random < 35) { // 1/128
    obj_add(npc_coord, deathrune, 3, ^lootdrop_duration);
} else if ($random < 36) {
    if (map_members = true) {
        obj_add(npc_coord, bloodrune, 2, ^lootdrop_duration);
    } else {
        obj_add(npc_coord, black_kiteshield, 1, ^lootdrop_duration);
    }
} else if ($random < 68) {
    obj_add(npc_coord, coins, 117, ^lootdrop_duration);
} else if ($random < 80) {
    obj_add(npc_coord, coins, 53, ^lootdrop_duration);
} else if ($random < 90) {
    obj_add(npc_coord, coins, 196, ^lootdrop_duration);
} else if ($random < 97) {
    obj_add(npc_coord, coins, 8, ^lootdrop_duration);
} else if ($random < 103) {
    obj_add(npc_coord, coins, 22, ^lootdrop_duration);
} else if ($random < 105) {
    obj_add(npc_coord, coins, 400, ^lootdrop_duration);
} else if ($random < 108) {
    obj_add(npc_coord, jug_wine, 1, ^lootdrop_duration);
} else if ($random < 109) {
    obj_add(npc_coord, mithril_ore, 1, ^lootdrop_duration);
} else if ($random < 110) {
    obj_add(npc_coord, banana, 1, ^lootdrop_duration);
} else if ($random < 114) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
    obj_add(npc_coord, ~grindingtable, ^lootdrop_duration);
} else if ($random < 115) {
    obj_add(npc_coord, ~high_tier_items, ^lootdrop_duration);
} else if ($random < 127) {
    obj_add(npc_coord, hound_cavalier, 1, ^lootdrop_duration);
}

[queue,hellhound_kill]
if (%active_slayer_task = ^hellhound){
    @slayer_kill(%active_slayer_task, %task_amount, %current_count);
}
if (%e_ctoggle = ^e_toggle_on){
    mes("You etch another tally into your ledger.");
}
%hellhound_kc = calc(%hellhound_kc + 1);