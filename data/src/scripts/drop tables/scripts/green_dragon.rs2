[ai_queue3,green_dragon]
if (npc_findhero = false) {
    return;
}
if (npc_findhero = true) {
    queue(green_dragon_kill, 0);
}
gosub(npc_death);
// Default drop from config.
obj_add(npc_coord, npc_param(death_drop), 1, ^lootdrop_duration);
//obj_add(npc_coord, dragonhide_green, 1, ^lootdrop_duration);
if (%hunter > 396) {
    if (%e_ctoggle = ^e_toggle_on) {
        mes("[4x] Resources!");
    }
} else if (%hunter > 349) {
    if (%e_ctoggle = ^e_toggle_on) {
        mes("[2x] Resources!");
    }
}
// Tertiary
~trail_hardcluedrop(128, npc_coord);
def_obj $knife = ~skinning_checker;
def_namedobj $scale = green_dragon_scale;
def_int $drop_multiplier = 1;
if (distance(coord, npc_coord) < 3){
    switch_obj($knife){
        case e_dragon_knife : {
            $drop_multiplier = 5;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_rune_knife : {
            $drop_multiplier = 4;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_adamant_knife : {
            $drop_multiplier = 3;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_mithril_knife : {
            $drop_multiplier = 2;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_steel_knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case e_bronze_knife : {
            $drop_multiplier = 1;
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }
        }
        case hc_knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }
        case founders_knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }
        case knife : {
            $drop_multiplier = 1;    
            if (%hunter > 396) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,4), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,4), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,4))>");
            } else if (%hunter > 349) {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,2), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,2), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,2))>");
            } else {
                obj_add(npc_coord, dragonhide_green, add($drop_multiplier,1), ^lootdrop_duration);
                obj_add(npc_coord, $scale, add($drop_multiplier,1), ^lootdrop_duration);
                mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
            }        
        }

        case null : mes("You don't have a knife to skin this monster.");
    }
    mes("You carve the monster and receive <tostring(add($drop_multiplier,1))>");
} else {
    mes("You were not close enough to attempt skinning the monster.");
}
def_int $random = random(128);

if ($random < 4) {
    obj_add(npc_coord, steel_platelegs, 1, ^lootdrop_duration);
} else if ($random < 7) {
    obj_add(npc_coord, steel_battleaxe, 1, ^lootdrop_duration);
} else if ($random < 10) {
    obj_add(npc_coord, mithril_axe, 1, ^lootdrop_duration);
} else if ($random < 12) {
    obj_add(npc_coord, mithril_spear, 1, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, mithril_kiteshield, 1, ^lootdrop_duration);
} else if ($random < 14) {
    obj_add(npc_coord, adamant_full_helm, 1, ^lootdrop_duration);
} else if ($random < 15) {
    obj_add(npc_coord, rune_dagger, 1, ^lootdrop_duration);
} else if ($random < 23) {
    obj_add(npc_coord, waterrune, 75, ^lootdrop_duration);
} else if ($random < 28) {
    obj_add(npc_coord, naturerune, 15, ^lootdrop_duration);
} else if ($random < 31) {
    obj_add(npc_coord, lawrune, 3, ^lootdrop_duration);
} else if ($random < 32) {
    obj_add(npc_coord, firerune, 37, ^lootdrop_duration);
} else if ($random < 47) {
    obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
} else if ($random < 76) {
    obj_add(npc_coord, coins, 44, ^lootdrop_duration);
} else if ($random < 101) {
    obj_add(npc_coord, coins, 132, ^lootdrop_duration);
} else if ($random < 111) {
    obj_add(npc_coord, coins, 200, ^lootdrop_duration);
} else if ($random < 116) {
    obj_add(npc_coord, coins, 11, ^lootdrop_duration);
} else if ($random < 117) {
    obj_add(npc_coord, coins, 440, ^lootdrop_duration);
} else if ($random < 120) {
    obj_add(npc_coord, bass, 1, ^lootdrop_duration);
} else if ($random < 123) {
    obj_add(npc_coord, adamantite_ore, 1, ^lootdrop_duration);
} else if ($random < 128) {
    obj_add(npc_coord, ~randomjewel, ^lootdrop_duration);
    obj_add(npc_coord, ~grindingtable, ^lootdrop_duration);
}

[queue,green_dragon_kill]
if (~wilderness_level(coord) > 0){
    obj_add(coord, ~wilderness_table, ^lootdrop_duration);
}
if (%e_ctoggle = ^e_toggle_on){
    mes("You etch another tally into your ledger.");
}
%green_dragon_kc = calc(%green_dragon_kc + 1);