[opnpc1,duke_horacio]
if(%gamemode_selected = ^gamemode_pvp){
    ~chatnpc("<p,angry>GO AWAY!");
    return;
}
~chatnpc("<p,neutral>Greetings. Welcome to my castle.");

if ((%dragon_shield = ^quest_dragon_knows_about_shield | %dragon_progress >= ^dragon_complete) & inv_total(inv, antidragonbreathshield) < 1 & inv_total(worn, antidragonbreathshield) < 1) {
    @multi3("I seek a shield that will protect me from the dragon's breath.", duke_horacio_shield, "Have you any quests for me?", ~duke_handle_rune_mysteries, "Where can I find skill capes?", duke_horacio_money);
} else {
    @multi2("Have you any quests for me?", ~duke_handle_rune_mysteries, "Where can I find skill capes?", duke_horacio_money);

}

@duke_horacio_money;

[proc,duke_handle_rune_mysteries]()(label)
if (%runemysteries_progress = ^runemysteries_not_started) return(duke_rune_mysteries_start);
else if (%runemysteries_progress = ^runemysteries_complete) return(duke_rune_mysteries_complete);
else return (duke_rune_mysteries_in_progress);

[label,duke_horacio_money]
~chatnpc("<p,neutral>Let's see if you got the skills!");
//~openshop_activenpc;

def_int $c1 = ~p_choice5_header("Attack.", 1, "Strength.", 2, "Defence.", 3, "Ranged.", 4, "Next.", 5, "Cape Selection");
switch_int($c1){
    case 1 : {
        if (stat_base(attack) ! 99){
            mes("You need to be level 99 Attack to use this cape!");
            return;
        }
        if (inv_total(inv, coins) < 1000000){
            mes("You need to have at least 1,000,000 coins to use this cape!");
            return;
        }
        inv_del(inv, coins, 1000000);
        mes("You now own an Attack Cape!");
        inv_add(inv, attack_cape, 1);       
    }
    case 2 : {
        if (stat_base(strength) ! 99){
            mes("You need to be level 99 Strength to use this cape!");
            return;
        }
        if (inv_total(inv, coins) < 1000000){
            mes("You need to have at least 1,000,000 coins to use this cape!");
            return;
        }
        inv_del(inv, coins, 1000000);
        mes("You now own a Strength Cape!");
        inv_add(inv, strength_cape, 1);       
    }
    case 3 : {
        if (stat_base(defence) ! 99){
            mes("You need to be level 99 Defence to use this cape!");
            return;
        }
        if (inv_total(inv, coins) < 1000000){
            mes("You need to have at least 1,000,000 coins to use this cape!");
            return;
        }
        inv_del(inv, coins, 1000000);
        mes("You now own a Defence Cape!");
        inv_add(inv, defence_cape, 1);
    }
    case 4 : {
        if (stat_base(ranged) ! 99){
            mes("You need to be level 99 Ranged to use this cape!");
            return;
        }
        if (inv_total(inv, coins) < 1000000){
            mes("You need to have at least 1,000,000 coins to use this cape!");
            return;
        }
        inv_del(inv, coins, 1000000);
        mes("You now own a Ranged Cape!");
        inv_add(inv, ranged_cape, 1);
    }
    case 5 : {
        def_int $c2 = ~p_choice5_header("Prayer.", 1, "Magic.", 2, "Runecraft.", 3, "Hitpoints.", 4, "Next.", 5, "Cape Selection");
        switch_int($c2){
            case 1 : {
                if (stat_base(prayer) ! 99){
                    mes("You need to be level 99 Prayer to use this cape!");
                    return;
                }
                if (inv_total(inv, coins) < 1000000){
                    mes("You need to have at least 1,000,000 coins to use this cape!");
                    return;
                }
                inv_del(inv, coins, 1000000);
                mes("You now own a Prayer Cape!");
                inv_add(inv, prayer_cape, 1);
            }
            case 2 : {
                if (stat_base(magic) ! 99){
                    mes("You need to be level 99 Magic to use this cape!");
                    return;
                }
                if (inv_total(inv, coins) < 1000000){
                    mes("You need to have at least 1,000,000 coins to use this cape!");
                    return;
                }
                inv_del(inv, coins, 1000000);
                mes("You now own a Magic Cape!");
                inv_add(inv, magic_cape, 1);
            }
            case 3 : {
                if (stat_base(runecraft) ! 99){
                    mes("You need to be level 99 Runecrafting to use this cape!");
                    return;
                }
                if (inv_total(inv, coins) < 1000000){
                    mes("You need to have at least 1,000,000 coins to use this cape!");
                    return;
                }
                inv_del(inv, coins, 1000000);
                mes("You now own a Runecrafting Cape!");
                inv_add(inv, runecrafting_cape, 1);
            }
            case 4 : {
                if (stat_base(hitpoints) ! 99){
                    mes("You need to be level 99 Hitpoints to use this cape!");
                    return;
                }
                if (inv_total(inv, coins) < 1000000){
                    mes("You need to have at least 1,000,000 coins to use this cape!");
                    return;
                }
                inv_del(inv, coins, 1000000);
                mes("You now own a Hitpoints Cape!");
                inv_add(inv, hitpoints_cape, 1);
            }
            case 5 : {
                def_int $c3 = ~p_choice5_header("Agility.", 1, "Herblore.", 2, "Thieving.", 3, "Crafting.", 4, "Next.", 5, "Cape Selection");
                switch_int($c3){
                    case 1 : {
                        if (stat_base(agility) ! 99){
                            mes("You need to be level 99 Agility to use this cape!");
                            return;
                        }
                        if (inv_total(inv, coins) < 1000000){
                            mes("You need to have at least 1,000,000 coins to use this cape!");
                            return;
                        }
                        inv_del(inv, coins, 1000000);
                        mes("You now own an Agility Cape!");
                        inv_add(inv, agility_cape, 1);
                    }
                    case 2 : {
                        if (stat_base(herblore) ! 99){
                            mes("You need to be level 99 Herblore to use this cape!");
                            return;
                        }
                        if (inv_total(inv, coins) < 1000000){
                            mes("You need to have at least 1,000,000 coins to use this cape!");
                            return;
                        }
                        inv_del(inv, coins, 1000000);
                        mes("You now own a Herblore Cape!");
                        inv_add(inv, herblore_cape, 1);
                    }
                    case 3 : {
                        if (stat_base(thieving) ! 99){
                            mes("You need to be level 99 Thieving to use this cape!");
                            return;
                        }
                        if (inv_total(inv, coins) < 1000000){
                            mes("You need to have at least 1,000,000 coins to use this cape!");
                            return;
                        }
                        inv_del(inv, coins, 1000000);
                        mes("You now own a Thieving Cape!");
                        inv_add(inv, thieving_cape, 1);
                    }
                    case 4 : {
                        if (stat_base(crafting) ! 99){
                            mes("You need to be level 99 Crafting to use this cape!");
                            return;
                        }
                        if (inv_total(inv, coins) < 1000000){
                            mes("You need to have at least 1,000,000 coins to use this cape!");
                            return;
                        }
                        inv_del(inv, coins, 1000000);
                        mes("You now own a Crafting Cape!");
                        inv_add(inv, crafting_cape, 1);
                    }
                    case 5 : {
                        def_int $c4 = ~p_choice5_header("Fletching.", 1, "Mining.", 2, "Smithing.", 3, "Fishing.", 4, "Next.", 5, "Cape Selection");
                        switch_int($c4){
                            case 1 : {
                                if (stat_base(fletching) ! 99){
                                    mes("You need to be level 99 Fletching to use this cape!");
                                    return;
                                }
                                if (inv_total(inv, coins) < 1000000){
                                    mes("You need to have at least 1,000,000 coins to use this cape!");
                                    return;
                                }
                                inv_del(inv, coins, 1000000);
                                mes("You now own a Fletching Cape!");
                                inv_add(inv, fletching_cape, 1);
                            }
                            case 2 : {
                                if (stat_base(mining) ! 99){
                                    mes("You need to be level 99 Mining to use this cape!");
                                    return;
                                }
                                if (inv_total(inv, coins) < 1000000){
                                    mes("You need to have at least 1,000,000 coins to use this cape!");
                                    return;
                                }
                                inv_del(inv, coins, 1000000);
                                mes("You now own a Mining Cape!");
                                inv_add(inv, mining_cape, 1);
                            }
                            case 3 : {
                                if (stat_base(smithing) ! 99){
                                    mes("You need to be level 99 Smithing to use this cape!");
                                    return;
                                }
                                if (inv_total(inv, coins) < 1000000){
                                    mes("You need to have at least 1,000,000 coins to use this cape!");
                                    return;
                                }
                                inv_del(inv, coins, 1000000);
                                mes("You now own a Smithing Cape!");
                                inv_add(inv, blacksmithing_cape, 1);
                            }
                            case 4 : {
                                if (stat_base(fishing) ! 99){
                                    mes("You need to be level 99 Fishing to use this cape!");
                                    return;
                                }
                                if (inv_total(inv, coins) < 1000000){
                                    mes("You need to have at least 1,000,000 coins to use this cape!");
                                    return;
                                }
                                inv_del(inv, coins, 1000000);
                                mes("You now own a Fishing Cape!");
                                inv_add(inv, fishing_cape, 1);
                            }
                            case 5 : {
                                def_int $c5 = ~p_choice3_header("Cooking.", 1, "Firemaking.", 2, "Woodcutting.", 3, "Cape Selection");
                                switch_int($c5){
                                    case 1 : {
                                        if (stat_base(cooking) ! 99){
                                            mes("You need to be level 99 Cooking to use this cape!");
                                            return;
                                        }
                                        if (inv_total(inv, coins) < 1000000){
                                            mes("You need to have at least 1,000,000 coins to use this cape!");
                                            return;
                                        }
                                        inv_del(inv, coins, 1000000);
                                        mes("You now own a Cooking Cape!");
                                        inv_add(inv, cooking_cape, 1);
                                    }
                                    case 2 : {
                                        if (stat_base(firemaking) ! 99){
                                            mes("You need to be level 99 Firemaking to use this cape!");
                                            return;
                                        }
                                        if (inv_total(inv, coins) < 1000000){
                                            mes("You need to have at least 1,000,000 coins to use this cape!");
                                            return;
                                        }
                                        inv_del(inv, coins, 1000000);
                                        mes("You now own a Firemaking Cape!");
                                        inv_add(inv, firemaking_cape, 1);
                                    }
                                    case 3 : {
                                        if (stat_base(woodcutting) ! 99){
                                            mes("You need to be level 99 Woodcutting to use this cape!");
                                            return;
                                        }
                                        if (inv_total(inv, coins) < 1000000){
                                            mes("You need to have at least 1,000,000 coins to use this cape!");
                                            return;
                                        }
                                        inv_del(inv, coins, 1000000);
                                        mes("You now own a Woodcutting Cape!");
                                        inv_add(inv, woodcutting_cape, 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

[label,duke_rune_mysteries_start]
~chatplayer("<p,quiz>Have you any quests for me?");
~chatnpc("<p,neutral>Well, it's not really a quest but I recently discovered this strange talisman.");
~chatnpc("<p,neutral>It seems to be mystical and I have never seen anything like it before. Would you take it to the head wizard at");
~chatnpc("<p,neutral>the Wizards' Tower for me? It's just south-west of here and should not take you very long at all. I would be awfully grateful.");
def_int $option = ~p_choice2("Sure, no problem.", 1, "Not right now.", 2);
if ($option = 1) {
    ~chatplayer("<p,happy>Sure, no problem.");
    %runemysteries_progress = ^runemysteries_started;
    ~send_quest_progress(questlist:runemysteries, %runemysteries_progress, ^runemysteries_complete);
    ~chatnpc("<p,happy>Thank you very much, stranger. I am sure the head wizard will reward you for such an interesting find.");
    // https://youtu.be/khWXGF8spNs?t=40, inv space check prob added later during OSRS (chisel dialogue doesn't have anything related)
    ~mesbox("The Duke hands you an @blu@air talisman.");
    inv_add(inv, air_talisman, 1);
} else if($option = 2) {
    ~chatplayer("<p,neutral>Not right now.");
    ~chatnpc("<p,sad>As you wish, stranger, although I have this strange feeling that it is important. Unfortunately, I cannot leave my castle unattended.");
}

[label,duke_rune_mysteries_in_progress]
if(~obj_gettotal(air_talisman) = 0) {
    ~chatnpc("<p,neutral>Did you speak to the head wizard for me yet, adventurer?");
    ~chatplayer("<p,neutral>No, I lost that talisman that you gave me.");
    ~chatnpc("<p,neutral>Ah, that would explain it. One of my servants found this outside, and it seemed too much of a coincidence that more than one strange.");
    ~chatnpc("<p,neutral>object would appear on my land in such a short period of time. Please take this to the head wizard at the Wizards' Tower, south-west of here, and don't lose it this time.");
    ~mesbox("The Duke hands you an @blu@air talisman.");
    inv_add(inv, air_talisman, 1);
} else {
    ~chatnpc("<p,neutral>The only task remotely approaching a quest is the delivery of that talisman I gave you to the head wizard of the Wizards' Tower,");
    ~chatnpc("<p,neutral>south-west of here. I suggest you deliver it to him as soon as possible. I have the oddest feeling that it is important...");
}

[label,duke_rune_mysteries_complete]
~chatplayer("<p,neutral>Have you any quests for me?");
~chatnpc("<p,neutral>No, all is well for me."); // chisel

// dragon slayer
[label,duke_horacio_shield]
// Dialogue is taken from rsc
~chatplayer("<p,neutral>I seek a shield that will protect me from the dragon's breath.");
~chatnpc("<p,quiz>A knight going on a dragon quest, hmm?|A most worthy cause.|Guard this well my friend.");
inv_add(inv, antidragonbreathshield, 1);
~objbox(antidragonbreathshield, "The Duke hands you a shield.", 250, 0, 0);
