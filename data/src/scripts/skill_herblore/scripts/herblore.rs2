/** Identify herb and give experience. */
[proc,identify_herb](namedobj $identified_herb, int $slot)
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
def_int $experience = oc_param($identified_herb, identified_herb_exp);
def_string $message = oc_param($identified_herb, identified_herb_message);
inv_setslot(inv, $slot, $identified_herb, 1);
mes($message); // https://youtu.be/RVnSlXYGPe0?t=72
stat_advance(herblore, $experience);
%herbs_cleaned = calc(%herbs_cleaned + 1);

/** Brew a potion. */
[proc,brew_potion](struct $struct, namedobj $ingredient, namedobj $solvent, string $message, namedobj $mixture, int $experience)
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}
inv_del(inv, $ingredient, 1);
inv_del(inv, $solvent, 1);
// There is always a guaranteed slot available.
inv_add(inv, $mixture, 1);
// https://youtu.be/S6P-hUzgqPw?t=1
mes($message);
anim(human_herbing_vial, 0);
sound_synth(grind, 0, 0);
stat_advance(herblore, $experience);
if (inv_total(worn, gasmask) > 0 | inv_total(worn, founders_partyhat) > 0) {
            stat_advance(herblore, $experience);
            mes("Your herblore skills are showing!");
}
%potions_brewed = calc(%potions_brewed + 1);
/** Grind a herblore ingredient. */
[proc,grind_ingredient](obj $grindable, namedobj $refined, string $message, int $slot, int $quantity)
if(%gamemode_selected = ^gamemode_pvp){
    mes("You cannot do this.");
    return;
}

def_int $batch_size = 1;
if ($quantity >= 25) {
    $batch_size = 25;
} else if ($quantity >= 10) {
    $batch_size = 10;
} else if ($quantity >= 5) {
    $batch_size = 5;
}

// Check if we have space for the product if we aren't consuming the whole stack
// If we consume the whole stack ($batch_size == $quantity), the slot becomes free, so we don't need extra space.
// If we don't consume the whole stack, we need a free slot OR an existing stack of the product.
if ($batch_size < $quantity) {
    if (inv_freespace(inv) = 0 & inv_total(inv, $refined) = 0) {
        mes("You don't have enough inventory space.");
        return;
    }
}

inv_del(inv, $grindable, $batch_size);
inv_add(inv, $refined, $batch_size);
// https://youtu.be/QUWaqEBTrCE?t=107
mes($message);
anim(human_herbing_grind, 0);
sound_synth(grind, 0, 0);
%herbs_ground = calc(%herbs_ground + 1);