[oploc1,_bookcase]
// https://youtu.be/YT_tGdVMjGs?t=259
// todo: confirm for other bookcase loc's
p_arrivedelay;
//mes(~coord_tostring(loc_coord));
switch_coord (loc_coord) {
    case 0_52_52_38_4, 0_52_52_36_4, 0_52_52_36_6, 0_52_52_38_7, 0_52_52_36_7, 0_52_52_39_8 : @exam_centre_bookcase; // exam centre bookcases
    case default : @search_bookcase;
}

[label,search_bookcase]
mes("You search the bookcase...");
p_delay(1);
def_int $rand = random(4);
if ($rand = 0) {
    mes("None of them look very interesting.");
} else if ($rand = 1) {
    mes("You find nothing to interest you.");
} else if ($rand = 2) {
    mes("You don't find anything that you'd ever want to read.");
} else {
    ~prestige_check;
    if (%intelligence > 189) {
        mes("You find a certificate for Rune Essence!");
        mes("Your Intelligence is showing!");
        sound_synth(dice_roll, 1, 0);
        if (inv_freespace(inv) > 0) {
            inv_add(inv, cert_rune_fragment,15);
        } else if (inv_freespace(inv) < 0) {
            ~mesbox("You can't fit it in your inventory.");
        } 
    } else if (%intelligence > 74){
        if (inv_total(inv, unfinished_book_of_chaos) < 1 & inv_total(bank, unfinished_book_of_chaos) < 1){
            mes("You find a dusty old book!");
            if (inv_freespace(inv) > 0){
                inv_add(inv, unfinished_book_of_chaos, 1);
            } else {
                ~mesbox("You can't fit it in your inventory.");
                return;
            }
        }
        switch_int(random(128)) {
            case 5 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page1, 1);
                return;
            }
            case 17 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page2, 1);
                return;
            }
            case 29 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page3, 1);
                return;
            }
            case 41 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page4, 1);
                return;
            }
            case 53 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page5, 1);
                return;
            }
            case 65 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page6, 1);
                return;
            }
            case 77 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page7, 1);
                return;
            }
            case 89 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page8, 1);
                return;
            }
            case 101 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page9, 1);
                return;
            }
            case 113 : {
                mes("You find a mysterious page.");
                inv_add(inv, enscribed_page10, 1);
                return;
            }
        }

    }

}